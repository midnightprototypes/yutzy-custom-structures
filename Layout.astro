---
import '@fontsource/archivo/600.css';
import '@fontsource/archivo/700.css';
import '@fontsource/archivo/800.css';
import '@fontsource/barlow/400.css';
import '@fontsource/barlow/500.css';
import '@fontsource/barlow/600.css';
import { business } from '../data/site';
const b = business;
interface Props { title: string; description: string; image?: string; }
const { title, description, image = b.logo } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const schema = {
  "@context": "https://schema.org",
  "@type": "GeneralContractor",
  name: b.name,
  image: b.logo,
  telephone: b.phoneMainHref,
  url: b.url,
  address: {
    "@type": "PostalAddress",
    streetAddress: b.address.street,
    addressLocality: b.address.city,
    addressRegion: b.address.region,
    postalCode: b.address.zip,
    addressCountry: b.address.country,
  },
  areaServed: b.areaServed,
  openingHours: "Mo-Fr 08:00-17:00",
  priceRange: "$$",
};
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="icon" href="/favicon.svg" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={image} />
  <meta name="twitter:card" content="summary_large_image" />
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
</head>
<body>

<header class="site">
  <div class="wrap navbar">
    <a class="brand" href="index.html" aria-label={b.name}>
      <span class="mono" aria-hidden="true">YCS</span>
      <span class="brandtext"><b>Yutzy Custom Structures</b><small>Heritage Craftsmanship</small></span>
    </a>
    <nav class="nav-links">
      <a href="index.html#buildings">Buildings</a>
      <a href="gallery.html">Gallery</a>
      <a href="index.html#why">Why Yutzy</a>
      <a href="index.html#area">Service Area</a>
      <a href="faq.html">FAQ</a>
      <a href="index.html#contact">Contact</a>
    </nav>
    <div class="nav-cta">
      <a class="nav-phone" href={`tel:${b.phoneMainHref}`}>{b.phoneMain}<span>{b.hoursShort}</span></a>
      <a class="btn btn-red" href="index.html#contact">Get a Free Quote</a>
    </div>
  </div>
</header>

<main>
  <slot />
</main>

<footer class="site">
  <div class="wrap foot-grid">
    <div>
      <a class="brand" href="index.html" style="margin-bottom:.8rem" aria-label={b.name}>
        <span class="mono" aria-hidden="true">YCS</span>
        <span class="brandtext"><b style="color:#fff">Yutzy Custom Structures</b><small style="color:#b3a99b">Heritage Craftsmanship</small></span>
      </a>
      <p style="color:#c7bfb2;max-width:32ch">Family-owned Amish post-frame builders serving Kansas &amp; Missouri since 2005.</p>
      <p style="margin-top:.8rem"><a href={b.facebook} target="_blank" rel="noopener">Facebook</a> &nbsp;·&nbsp; <a href={b.houzz} target="_blank" rel="noopener">Houzz</a></p>
    </div>
    <div>
      <p class="foot-h">Contact</p>
      <p>Kansas: <a href={`tel:${b.phoneMainHref}`}>{b.phoneMain}</a></p>
      <p>Missouri: <a href={`tel:${b.phoneMOHref}`}>{b.phoneMO}</a></p>
      <p>{b.address.street}<br />{b.address.city}, {b.address.region} {b.address.zip}</p>
      <p>{b.hours}</p>
    </div>
    <div>
      <p class="foot-h">Buildings</p>
      <p><a href="pole-barns.html">Pole Barns</a></p>
      <p><a href="post-frame-garages.html">Garages</a></p>
      <p><a href="hobby-shops.html">Hobby Shops</a></p>
      <p><a href="barndominiums.html">Barndominiums</a></p>
      <p><a href="slab-homes.html">Slab Homes</a></p>
    </div>
    <div>
      <p class="foot-h">Service Areas</p>
      <p><a href="pole-barn-builders-ottawa-ks.html">Ottawa, KS</a></p>
      <p><a href="pole-barn-builders-emporia-ks.html">Emporia, KS</a></p>
      <p><a href="pole-barn-builders-overland-park-ks.html">Overland Park, KS</a></p>
      <p><a href="pole-barn-builders-lawrence-ks.html">Lawrence, KS</a></p>
      <p><a href="pole-barn-builders-kansas-city-mo.html">Kansas City, MO</a></p>
    </div>
  </div>
  <div class="wrap foot-legal">© {new Date().getFullYear()} {b.name}. All rights reserved.</div>
</footer>

<a class="mobile-call" href={`tel:${b.phoneMainHref}`}>
  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2"><path d="M22 16.9v3a2 2 0 01-2.2 2 19.8 19.8 0 01-8.6-3 19.5 19.5 0 01-6-6 19.8 19.8 0 01-3-8.6A2 2 0 014.1 2h3a2 2 0 012 1.7c.1.9.3 1.8.6 2.6a2 2 0 01-.5 2.1L8.1 9.9a16 16 0 006 6l1.5-1.1a2 2 0 012.1-.5c.8.3 1.7.5 2.6.6a2 2 0 011.7 2z"/></svg>
  Tap to Call · {b.phoneMain}
</a>

<style is:global>
  :root{
    --red:#b26b2e; --red-dark:#955a22; --red-deep:#7d4a1c;
    --charcoal:#2c383c; --charcoal-deep:#1e2321;
    --ink:#242a27; --muted:#5c635e;
    --cream:#ede7d7; --cream-2:#e3dbc6; --line:#dcd3bf;
    --gold:#c2924a; --sage:#a8b29a; --white:#fff;
    --maxw:1140px; --r:14px;
    --shadow:0 10px 30px rgba(26,26,26,.12);
    --font-head:"Archivo", system-ui, sans-serif;
    --font-body:"Barlow", system-ui, -apple-system, sans-serif;
  }
  *{box-sizing:border-box}
  html{scroll-behavior:smooth}
  body{margin:0;font-family:var(--font-body);color:var(--ink);background:var(--cream);line-height:1.6}
  h1,h2,h3{font-family:var(--font-head);font-weight:800;line-height:1.1;letter-spacing:-.015em}
  img{max-width:100%;display:block}
  a{color:inherit}
  .wrap{max-width:var(--maxw);margin:0 auto;padding:0 clamp(1rem,4vw,2rem)}
  .btn{display:inline-block;padding:.85rem 1.4rem;border-radius:10px;font-weight:700;text-decoration:none;cursor:pointer;border:2px solid transparent;transition:.15s;font-size:1rem}
  .btn-red{background:var(--red);color:#fff}
  .btn-red:hover{background:var(--red-dark)}
  .btn-ghost{border-color:rgba(255,255,255,.5);color:#fff}
  .btn-ghost:hover{background:rgba(255,255,255,.12)}
  .eyebrow{text-transform:uppercase;letter-spacing:.14em;font-size:.78rem;font-weight:700;color:var(--gold)}
  .sec-head .eyebrow,.contact .eyebrow{color:var(--red-dark)}
  section{padding:clamp(3rem,7vw,5.5rem) 0}

  .ph{position:relative;border-radius:var(--r);overflow:hidden;background:linear-gradient(135deg,#3a4a4e,#2c383c 72%);display:flex;align-items:flex-end;color:rgba(255,255,255,.92);min-height:220px}
  .ph .shot{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:2;display:block}

  header.site{position:sticky;top:0;z-index:50;background:rgba(246,241,231,.92);backdrop-filter:blur(8px);border-bottom:1px solid var(--line)}
  .navbar{display:flex;align-items:center;justify-content:space-between;gap:1rem;padding:.7rem 0}
  .brand{display:flex;align-items:center;gap:.55rem;text-decoration:none}
  .brand .mark{width:40px;height:40px;border-radius:9px;background:var(--red);display:grid;place-items:center;flex:none}
  .brand .mono{font-family:var(--font-head);font-weight:700;font-size:1.4rem;letter-spacing:.04em;color:var(--charcoal-deep);border:2px solid var(--charcoal-deep);border-radius:7px;padding:1px 9px 3px;line-height:1;flex:none}
  footer.site .brand .mono{color:#fff;border-color:#fff}
  .brandtext b{display:block;font-family:var(--font-head);font-size:1.15rem;color:var(--charcoal-deep);line-height:1;letter-spacing:.01em}
  .brandtext small{display:block;font-size:.6rem;letter-spacing:.16em;text-transform:uppercase;color:var(--muted);margin-top:3px}
  @media(max-width:440px){.brandtext small{display:none}.brandtext b{font-size:1.05rem}}
  .nav-links{display:flex;gap:1.6rem;font-weight:600;font-size:.95rem}
  .nav-links a{text-decoration:none;color:var(--ink)}
  .nav-links a:hover{color:var(--red)}
  .nav-cta{display:flex;align-items:center;gap:1rem}
  .nav-phone{font-weight:700;text-decoration:none;color:var(--charcoal-deep);white-space:nowrap}
  .nav-phone span{display:block;font-size:.65rem;font-weight:600;color:var(--muted);letter-spacing:.04em}

  .hero{background:radial-gradient(120% 120% at 80% 0,#3a4a4e 0,var(--charcoal-deep) 62%);color:#fff}
  .hero-grid{display:grid;grid-template-columns:1.05fr .95fr;gap:clamp(1.5rem,4vw,3.5rem);align-items:center}
  .hero h1{font-size:clamp(2.2rem,5vw,3.5rem);margin:.6rem 0 1rem}
  .hero p.lede{font-size:1.18rem;color:rgba(255,255,255,.84);margin:0 0 1.8rem;max-width:34ch}
  .hero-cta{display:flex;flex-wrap:wrap;gap:.8rem}
  .hero .ph{min-height:400px;box-shadow:var(--shadow)}
  .badges{border-top:1px solid rgba(255,255,255,.16);margin-top:2.5rem}
  .badges .wrap{display:flex;flex-wrap:wrap;gap:1.4rem 2.4rem;padding-top:1.3rem;padding-bottom:.2rem}
  .badge{display:flex;align-items:center;gap:.55rem;color:rgba(255,255,255,.9);font-weight:600;font-size:.95rem}
  .badge svg{flex:none}

  /* full-bleed overlay hero */
  .ohero{position:relative;min-height:clamp(440px,68vh,600px);display:flex;align-items:flex-end;overflow:hidden}
  .ohero-bg{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
  .ohero-scrim{position:absolute;inset:0;background:linear-gradient(90deg,rgba(15,14,13,.85),rgba(15,14,13,.5) 45%,rgba(15,14,13,.1)),linear-gradient(0deg,rgba(15,14,13,.65),transparent 55%)}
  .ohero-inner{position:relative;color:#fff;padding-top:clamp(3rem,10vh,5.5rem);padding-bottom:clamp(2.5rem,7vh,4rem)}
  .ohero-eye{color:#f0d6ab}
  .ohero-title{color:#fff;font-size:clamp(2.3rem,5.4vw,4rem);margin:.6rem 0 1rem;max-width:17ch;text-shadow:0 2px 24px rgba(0,0,0,.35)}
  .ohero-sub{font-size:1.2rem;color:rgba(255,255,255,.9);max-width:46ch;margin:0 0 1.8rem}
  .trust-strip{background:var(--charcoal-deep);color:#fff;padding:1.05rem 0}
  .badges-row{display:flex;flex-wrap:wrap;gap:.9rem 2.4rem;justify-content:center}

  /* icon feature cards with bottom accent bar */
  .feat-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:1.3rem;margin-top:1.6rem}
  .feat-card{position:relative;background:#fff;border:1px solid var(--line);border-radius:var(--r);padding:1.6rem 1.5rem 1.8rem;overflow:hidden}
  .feat-icon{display:inline-grid;place-items:center;width:46px;height:46px;border-radius:12px;background:rgba(178,107,46,.10);color:var(--red);margin-bottom:.9rem}
  .feat-card h3{margin:0 0 .35rem;font-size:1.12rem;color:var(--charcoal-deep)}
  .feat-card p{margin:0;color:var(--muted);font-size:.94rem}
  .feat-bar{position:absolute;left:0;right:0;bottom:0;height:5px;background:var(--red)}
  @media(max-width:900px){.feat-grid{grid-template-columns:1fr 1fr}}
  @media(max-width:560px){.feat-grid{grid-template-columns:1fr}}

  /* content pages: FAQ + articles */
  .pagehead{background:radial-gradient(120% 120% at 80% 0,#3a4a4e 0,var(--charcoal-deep) 62%);color:#fff;padding:clamp(2.5rem,6vw,4.5rem) 0}
  .pagehead h1{color:#fff;font-size:clamp(2rem,4.5vw,3rem);margin:.4rem 0 .8rem;max-width:24ch}
  .pagehead p{color:rgba(255,255,255,.86);max-width:60ch;font-size:1.12rem;margin:0}
  .prose{max-width:72ch;margin:0 auto}
  .prose h2{color:var(--charcoal-deep);font-size:1.5rem;margin:2.2rem 0 .6rem}
  .prose p{margin:0 0 1.05rem}
  .prose a{color:var(--red-dark);font-weight:600}
  .prose .lead-p{font-size:1.18rem;color:var(--ink)}
  .faq-wrap{max-width:820px;margin:0 auto}
  .faq-item{border-bottom:1px solid var(--line)}
  .faq-item summary{cursor:pointer;font-weight:700;font-family:var(--font-head);font-size:1.12rem;color:var(--charcoal-deep);padding:1.05rem 0;list-style:none;display:flex;justify-content:space-between;gap:1rem;align-items:center}
  .faq-item summary::-webkit-details-marker{display:none}
  .faq-item summary::after{content:'+';color:var(--red);font-weight:700;font-size:1.4rem;line-height:1}
  .faq-item[open] summary::after{content:'\2013'}
  .faq-a{color:var(--muted);padding:0 0 1.1rem;max-width:70ch;line-height:1.6}

  .sec-head{text-align:center;max-width:640px;margin:0 auto 2.6rem}
  .sec-head h2{font-size:clamp(1.8rem,4vw,2.5rem);margin:.5rem 0 .6rem;color:var(--charcoal-deep)}
  .sec-head p{color:var(--muted);margin:0;font-size:1.05rem}
  .cards{display:grid;grid-template-columns:repeat(3,1fr);gap:1.4rem}
  .card{background:#fff;border:1px solid var(--line);border-radius:var(--r);overflow:hidden;display:flex;flex-direction:column;box-shadow:0 1px 0 rgba(0,0,0,.02);transition:.15s}
  .card:hover{transform:translateY(-3px);box-shadow:var(--shadow)}
  .card .ph{border-radius:0;min-height:190px}
  .card-body{padding:1.25rem 1.35rem 1.4rem;display:flex;flex-direction:column;gap:.4rem;flex:1}
  .card-body h3{margin:0;font-size:1.25rem;color:var(--charcoal-deep)}
  .card-body p{margin:0;color:var(--muted);font-size:.95rem}
  .card-body a.q{margin-top:.7rem;font-weight:700;color:var(--red);text-decoration:none;font-size:.95rem}
  .card-body a.q:hover{color:var(--red-dark)}

  .why{background:var(--cream-2)}
  .checks{list-style:none;padding:0;margin:0;display:grid;gap:1rem}
  .checks li{display:flex;gap:.8rem;align-items:flex-start}
  .checks svg{flex:none;margin-top:3px}
  .checks b{color:var(--red)}
  .checks-grid{grid-template-columns:1fr 1fr;gap:1.2rem 2.6rem;max-width:940px;margin:1.6rem auto 0}
  @media(max-width:760px){.checks-grid{grid-template-columns:1fr}}

  /* building detail pages */
  .detail{display:grid;grid-template-columns:1.5fr .9fr;gap:2.5rem;align-items:start}
  .lead-p{font-size:1.15rem;color:var(--ink);margin:0 0 1.5rem}
  .detail .checks{margin:0 0 1.6rem}
  .btn-outline{border-color:var(--red);color:var(--red)}
  .btn-outline:hover{background:var(--red);color:#fff}
  .detail-aside{position:sticky;top:90px}
  .aside-card{background:#fff;border:1px solid var(--line);border-left:5px solid var(--red);border-radius:var(--r);padding:1.5rem;display:grid;gap:1rem}
  .aside-card p{margin:0;font-size:.95rem;color:var(--muted);line-height:1.4}
  .aside-card b{color:var(--charcoal-deep)}
  @media(max-width:860px){.detail{grid-template-columns:1fr}.detail-aside{position:static}}

  .area{background:var(--red);color:#fff;text-align:center}
  .area h2{font-size:clamp(1.6rem,4vw,2.2rem);margin:.3rem 0 .6rem}
  .area p{color:rgba(255,255,255,.9);max-width:560px;margin:0 auto 1.4rem}
  .area .btn-red{background:#fff;color:var(--red-dark)}
  .area .btn-red:hover{background:var(--cream)}
  .area-band{position:relative;overflow:hidden}
  .area-band::before{content:"";position:absolute;inset:0;background:url('images/where-we-build.webp') center 64%/cover;z-index:0}
  .area-band::after{content:"";position:absolute;inset:0;background:linear-gradient(rgba(44,56,60,.84),rgba(30,35,33,.9));z-index:1}
  .area-band > .wrap{position:relative;z-index:2}

  .quotes{display:grid;grid-template-columns:repeat(3,1fr);gap:1.4rem}
  .quote{background:#fff;border:1px solid var(--line);border-radius:var(--r);padding:1.6rem}
  .stars{color:var(--gold);letter-spacing:.1em;margin-bottom:.6rem}
  .quote p{margin:0 0 1rem;font-size:1rem}
  .quote .who{font-weight:700;color:var(--charcoal-deep);font-size:.92rem}
  .ph-note{color:var(--muted);font-size:.8rem;font-style:italic}

  .contact{background:var(--cream-2)}
  .contact-grid{display:grid;grid-template-columns:1fr 1fr;gap:clamp(1.5rem,4vw,3rem);align-items:start}
  .contact h2{font-size:clamp(1.8rem,4vw,2.5rem);margin:.3rem 0 .8rem;color:var(--charcoal-deep)}
  .contact .call{display:inline-flex;align-items:center;gap:.6rem;font-weight:800;font-size:1.4rem;color:var(--red-dark);text-decoration:none;margin:.6rem 0}
  .contact .local{display:flex;gap:1.5rem;flex-wrap:wrap;margin:.4rem 0 .2rem}
  .contact .local div{font-size:.95rem}
  .contact .local b{color:var(--charcoal-deep)}
  .contact .local a{color:var(--red-dark);font-weight:700;text-decoration:none}
  .contact .fineprint{color:var(--muted);font-size:.9rem;margin-top:1rem}
  .form-slot{background:#fff;border:2px dashed var(--red);border-radius:var(--r);min-height:440px;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:2rem;color:var(--muted)}
  .form-slot svg{margin-bottom:.8rem}
  .form-slot b{color:var(--charcoal-deep);font-size:1.05rem}
  .form-wrap{max-width:560px;width:100%}

  footer.site{background:var(--charcoal-deep);color:#ddd6cc;padding:3rem 0 1.6rem}
  .foot-grid{display:grid;grid-template-columns:1.5fr 1fr 1fr 1.1fr;gap:1.6rem}
  footer.site a{color:#fff;text-decoration:none}
  footer.site a:hover{text-decoration:underline}
  .foot-h{font-weight:700;color:#fff;margin:0 0 .7rem;font-family:var(--font-head)}
  .foot-legal{border-top:1px solid rgba(255,255,255,.14);margin-top:2rem;padding-top:1.2rem;text-align:center;color:#b3a99b;font-size:.85rem}

  .mobile-call{display:none}
  @media(max-width:860px){
    .nav-links,.nav-phone{display:none}
    .navbar{padding:.5rem 0;gap:.5rem}
    .nav-cta .btn{padding:.6rem 1rem;font-size:.92rem}
    .hero-grid,.contact-grid{grid-template-columns:1fr}
    .hero .ph{min-height:260px;order:-1}
    .cards,.quotes{grid-template-columns:1fr}
    .foot-grid{grid-template-columns:1fr}
    .mobile-call{display:flex;position:fixed;bottom:0;left:0;right:0;z-index:60;background:var(--red);color:#fff;justify-content:center;gap:.5rem;padding:.9rem;font-weight:800;text-decoration:none;box-shadow:0 -4px 14px rgba(0,0,0,.15)}
    body{padding-bottom:3.4rem}
  }
</style>
</body>
</html>
