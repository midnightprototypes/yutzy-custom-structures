---
import Layout from '../layouts/Layout.astro';
import { gallery } from '../data/gallery';
---
<Layout
  title="Project Gallery | Yutzy Custom Structures"
  description="Browse finished pole barns, post-frame garages, hobby shops, and barndominiums built by Yutzy Custom Structures across Kansas & Missouri."
>
  <section class="pagehead">
    <div class="wrap">
      <span class="eyebrow" style="color:#f0d6ab">Our Work</span>
      <h1>Project Gallery</h1>
      <p>Real pole barns, garages, hobby shops, and barndominiums we've designed, delivered, and installed across Kansas &amp; Missouri.</p>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="gal-grid">
        {gallery.map((g, i) => (
          <a class="gal-item" href={g.src} data-i={i}>
            <img src={g.src} alt={g.alt} loading="lazy" />
          </a>
        ))}
      </div>
      <p style="text-align:center;margin-top:2.4rem">
        <a class="btn btn-red" href="index.html#contact">Get a Free Quote</a>
      </p>
    </div>
  </section>

  <!-- Lightbox -->
  <div class="lightbox" id="lightbox" role="dialog" aria-modal="true" aria-label="Photo viewer">
    <button class="lb-close" id="lbClose" aria-label="Close">&times;</button>
    <button class="lb-nav lb-prev" id="lbPrev" aria-label="Previous photo">&#8249;</button>
    <img id="lbImg" alt="Yutzy project photo" />
    <button class="lb-nav lb-next" id="lbNext" aria-label="Next photo">&#8250;</button>
    <div class="lb-count" id="lbCount"></div>
  </div>
</Layout>

<script is:inline>
  (function () {
    var items = [].slice.call(document.querySelectorAll('.gal-item'));
    if (!items.length) return;
    var srcs = items.map(function (a) { return a.getAttribute('href'); });
    var lb = document.getElementById('lightbox');
    var img = document.getElementById('lbImg');
    var count = document.getElementById('lbCount');
    var cur = 0;
    function show(i) { cur = (i + srcs.length) % srcs.length; img.src = srcs[cur]; count.textContent = (cur + 1) + ' / ' + srcs.length; }
    function open(i) { show(i); lb.classList.add('on'); document.body.style.overflow = 'hidden'; }
    function close() { lb.classList.remove('on'); document.body.style.overflow = ''; img.removeAttribute('src'); }
    items.forEach(function (a, i) { a.addEventListener('click', function (e) { e.preventDefault(); open(i); }); });
    document.getElementById('lbClose').addEventListener('click', close);
    document.getElementById('lbPrev').addEventListener('click', function (e) { e.stopPropagation(); show(cur - 1); });
    document.getElementById('lbNext').addEventListener('click', function (e) { e.stopPropagation(); show(cur + 1); });
    lb.addEventListener('click', function (e) { if (e.target === lb) close(); });
    document.addEventListener('keydown', function (e) {
      if (!lb.classList.contains('on')) return;
      if (e.key === 'Escape') close();
      else if (e.key === 'ArrowLeft') show(cur - 1);
      else if (e.key === 'ArrowRight') show(cur + 1);
    });
  })();
</script>

<style>
  .gal-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(270px,1fr));gap:1rem}
  .gal-item{display:block;border-radius:12px;overflow:hidden;border:1px solid var(--line);aspect-ratio:3/2;background:#e9eee9;cursor:zoom-in}
  .gal-item img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .25s}
  .gal-item:hover img{transform:scale(1.05)}

  .lightbox{position:fixed;inset:0;z-index:200;background:rgba(18,14,12,.92);display:none;align-items:center;justify-content:center;padding:2rem}
  .lightbox.on{display:flex}
  .lightbox img{max-width:92vw;max-height:86vh;border-radius:8px;box-shadow:0 12px 48px rgba(0,0,0,.55)}
  .lb-close{position:absolute;top:.6rem;right:1rem;background:none;border:none;color:#fff;font-size:2.6rem;line-height:1;cursor:pointer;opacity:.9}
  .lb-close:hover{opacity:1}
  .lb-nav{position:absolute;top:50%;transform:translateY(-50%);background:rgba(255,255,255,.12);border:none;color:#fff;font-size:2.4rem;width:54px;height:54px;border-radius:50%;cursor:pointer;display:grid;place-items:center;line-height:1}
  .lb-nav:hover{background:rgba(255,255,255,.24)}
  .lb-prev{left:1rem}.lb-next{right:1rem}
  .lb-count{position:absolute;bottom:1rem;left:0;right:0;text-align:center;color:#fff;font-size:.9rem;font-weight:600;opacity:.85}
  @media(max-width:600px){.lb-nav{width:44px;height:44px;font-size:2rem}.lb-prev{left:.3rem}.lb-next{right:.3rem}}
</style>
