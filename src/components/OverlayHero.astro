---
// Full-bleed hero: a photo that spans edge to edge with the headline sitting
// ON the image. A gradient "scrim" (dark overlay) keeps the text readable.
// Content sits lower-left — an editorial layout that reads more custom than
// a dead-centered hero.
import { business } from '../data/site';
const b = business;
interface Props {
  eyebrow?: string; title: string; subtitle?: string;
  image: string; alt: string; ctaHref?: string;
  ctaText?: string; ctaSecondaryText?: string; ctaSecondaryHref?: string;
  areaNote?: string; areaNoteHref?: string; full?: boolean;
}
const {
  eyebrow, title, subtitle, image, alt,
  ctaHref = 'index.html#contact', ctaText = 'Start Your Project',
  ctaSecondaryText, ctaSecondaryHref,
  areaNote, areaNoteHref, full = false,
} = Astro.props;
---
<section class={`ohero${full ? ' ohero-full' : ''}`}>
  <img class="ohero-bg" src={image} alt={alt} width="1400" height="875" fetchpriority="high" decoding="async" />
  <div class="ohero-scrim"></div>
  <div class="wrap ohero-inner">
    {eyebrow && <span class="eyebrow ohero-eye">{eyebrow}</span>}
    <h1 class="ohero-title">{title}</h1>
    {subtitle && <p class="ohero-sub">{subtitle}</p>}
    <div class="hero-cta">
      <a class="btn btn-red" href={ctaHref}>{ctaText}</a>
      {ctaSecondaryText && <a class="btn btn-ghost" href={ctaSecondaryHref}>{ctaSecondaryText}</a>}
    </div>
    <p class="ohero-phone">Prefer to talk? <a href={`tel:${b.phoneMainHref}`}>Call {b.phoneMain}</a></p>
    {areaNote && <p class="ohero-area">{areaNote} {areaNoteHref && <a href={areaNoteHref}>Check your area →</a>}</p>}
  </div>
</section>
