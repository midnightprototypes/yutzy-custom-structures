---
// Reusable photo grid + click-to-open lightbox (no external library).
// Clicking a photo opens it over a dimmed page with prev/next + keyboard nav,
// so visitors browse without leaving the page. ~1 KB of inline JS.
// Used on the main Gallery page and on each building detail page (filtered).
interface Img { src: string; alt: string }
interface Props { images: Img[] }
const { images } = Astro.props;
---
<div class="gal-grid">
  {images.map((g) => (
    <a class="gal-item" href={g.src}>
      <img src={g.src} alt={g.alt} loading="lazy" />
    </a>
  ))}
</div>

<div class="lightbox" role="dialog" aria-modal="true" aria-label="Photo viewer">
  <button class="lb-close" type="button" aria-label="Close">&times;</button>
  <button class="lb-nav lb-prev" type="button" aria-label="Previous photo">&#8249;</button>
  <img class="lb-img" alt="Project photo" />
  <button class="lb-nav lb-next" type="button" aria-label="Next photo">&#8250;</button>
  <div class="lb-count"></div>
</div>

<script is:inline>
  (function () {
    var root = document.currentScript.previousElementSibling;      // the .lightbox
    while (root && !root.classList.contains('lightbox')) root = root.previousElementSibling;
    var grid = root && root.previousElementSibling;                // the .gal-grid
    if (!root || !grid) return;
    var items = [].slice.call(grid.querySelectorAll('.gal-item'));
    var srcs = items.map(function (a) { return a.getAttribute('href'); });
    var img = root.querySelector('.lb-img');
    var count = root.querySelector('.lb-count');
    var cur = 0;
    function show(i) { cur = (i + srcs.length) % srcs.length; img.src = srcs[cur]; count.textContent = (cur + 1) + ' / ' + srcs.length; }
    function open(i) { show(i); root.classList.add('on'); document.body.style.overflow = 'hidden'; }
    function close() { root.classList.remove('on'); document.body.style.overflow = ''; img.removeAttribute('src'); }
    items.forEach(function (a, i) { a.addEventListener('click', function (e) { e.preventDefault(); open(i); }); });
    root.querySelector('.lb-close').addEventListener('click', close);
    root.querySelector('.lb-prev').addEventListener('click', function (e) { e.stopPropagation(); show(cur - 1); });
    root.querySelector('.lb-next').addEventListener('click', function (e) { e.stopPropagation(); show(cur + 1); });
    root.addEventListener('click', function (e) { if (e.target === root) close(); });
    document.addEventListener('keydown', function (e) {
      if (!root.classList.contains('on')) return;
      if (e.key === 'Escape') close();
      else if (e.key === 'ArrowLeft') show(cur - 1);
      else if (e.key === 'ArrowRight') show(cur + 1);
    });
  })();
</script>

<style>
  .gal-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(270px,1fr));gap:1rem}
  .gal-item{display:block;border-radius:12px;overflow:hidden;border:1px solid var(--line);aspect-ratio:3/2;background:var(--bg-alt,#e3dbc6);cursor:zoom-in}
  .gal-item img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .25s}
  .gal-item:hover img{transform:scale(1.05)}

  .lightbox{position:fixed;inset:0;z-index:200;background:rgba(18,14,12,.92);display:none;align-items:center;justify-content:center;padding:2rem}
  .lightbox.on{display:flex}
  .lightbox .lb-img{max-width:92vw;max-height:86vh;border-radius:8px;box-shadow:0 12px 48px rgba(0,0,0,.55)}
  .lb-close{position:absolute;top:.6rem;right:1rem;background:none;border:none;color:#fff;font-size:2.6rem;line-height:1;cursor:pointer;opacity:.9}
  .lb-close:hover{opacity:1}
  .lb-nav{position:absolute;top:50%;transform:translateY(-50%);background:rgba(255,255,255,.12);border:none;color:#fff;font-size:2.4rem;width:54px;height:54px;border-radius:50%;cursor:pointer;display:grid;place-items:center;line-height:1}
  .lb-nav:hover{background:rgba(255,255,255,.24)}
  .lb-prev{left:1rem}.lb-next{right:1rem}
  .lb-count{position:absolute;bottom:1rem;left:0;right:0;text-align:center;color:#fff;font-size:.9rem;font-weight:600;opacity:.85}
  @media(max-width:600px){.lb-nav{width:44px;height:44px;font-size:2rem}.lb-prev{left:.3rem}.lb-next{right:.3rem}}
</style>
