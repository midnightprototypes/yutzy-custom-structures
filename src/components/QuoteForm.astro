---
// Custom quote form with conditional logic. Submissions POST to
// business.quoteWebhookUrl (a GoHighLevel inbound webhook) when it's set;
// until then the form validates and shows a call-us fallback so no lead
// is silently lost.
import { business } from '../data/site';
const b = business;
---
<form class="quote-form" id="quoteForm" novalidate>
  <div class="qrow">
    <label>Full name<input name="name" type="text" required autocomplete="name" /></label>
  </div>
  <div class="qrow two">
    <label>Phone<input name="phone" type="tel" required autocomplete="tel" /></label>
    <label>Email<input name="email" type="email" required autocomplete="email" /></label>
  </div>
  <div class="qrow two">
    <label>Project location
      <select name="location" required>
        <option value="">Choose…</option>
        <option>Kansas</option>
        <option>Missouri</option>
      </select>
    </label>
    <label>Project type
      <select name="type" id="qtype" required>
        <option value="">Choose…</option>
        <option>Pole Barn</option>
        <option>Post-Frame Garage</option>
        <option>Hobby Shop</option>
        <option>Equestrian Barn</option>
        <option>Barndominium</option>
        <option>Post-Frame Home</option>
        <option>Slab Home</option>
        <option>Not sure yet</option>
      </select>
    </label>
  </div>
  <div class="qrow">
    <!-- required: every field GoHighLevel's External Tracking script has
         reliably captured so far (name/phone/email/location/type) happens
         to be `required`; sqft and message were the only optional ones and
         the only two that never came through. Testing that pattern here —
         asking for an approximate size is reasonable for a quote form
         regardless. -->
    <label>Approx. size (sq ft)<input name="sqft" type="text" inputmode="numeric" placeholder="e.g. 2,400" required /></label>
  </div>
  <div class="qrow">
    <label>Tell us about your project<textarea id="qmessageBox" rows="3" placeholder="Size, use, timeline, budget…"></textarea></label>
    <!-- GoHighLevel's External Tracking script doesn't read <textarea>
         values directly (confirmed by testing), so this mirror input stays
         in sync with the textarea above via JS and carries the real
         "message" field name. Visually hidden via CSS (not `hidden`/
         display:none — that's what makes a field invisible to the tracker
         too). `required` is toggled on only once it actually has content,
         so an empty optional message never blocks submission — same
         required-field theory being tested on sqft above, without forcing
         visitors to write something. -->
    <input type="text" name="message" id="qmessageMirror" class="visually-hidden" tabindex="-1" aria-hidden="true" />
  </div>
  <button class="btn btn-red" type="submit">Start My Project</button>
  <p class="qfine">A Yutzy team member will follow up to talk through your project. We'll only use your info to get in touch.</p>
  <p class="qmsg" id="qmsg" hidden></p>
</form>

<script is:inline define:vars={{ webhook: b.quoteWebhookUrl, phone: b.phoneMain }}>
  (function () {
    var f = document.getElementById('quoteForm'); if (!f) return;
    var type = document.getElementById('qtype');
    var msg = document.getElementById('qmsg');
    var messageBox = document.getElementById('qmessageBox');
    var messageMirror = document.getElementById('qmessageMirror');
    messageBox.addEventListener('input', function () {
      messageMirror.value = messageBox.value;
      messageMirror.required = messageBox.value.trim().length > 0;
    });
    // Preselect the project-type dropdown from a ?type= param, so a CTA like
    // "Talk Through My Project" (type=Not+sure+yet) or a building page's
    // "Start Your Barndominium" (type=Barndominium) lands with the right
    // option already chosen instead of making the visitor pick again.
    var wanted = new URLSearchParams(location.search).get('type');
    if (wanted) {
      var match = Array.from(type.options).find(function (o) {
        return o.value.toLowerCase() === wanted.toLowerCase();
      });
      if (match) { type.value = match.value; }
    }
    f.addEventListener('submit', async function (e) {
      e.preventDefault();
      if (!f.reportValidity()) return;
      var data = Object.fromEntries(new FormData(f).entries());
      msg.hidden = false;
      if (!webhook) {
        msg.textContent = 'Thanks, ' + (data.name || '') + '! Online submissions aren’t connected yet — please call ' + phone + ' and we’ll get you a quote.';
        msg.className = 'qmsg warn'; return;
      }
      msg.textContent = 'Sending…'; msg.className = 'qmsg';
      try {
        await fetch(webhook, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(data) });
        f.reset();
        msg.textContent = 'Thanks! Your request is in — our team will reach out shortly.'; msg.className = 'qmsg ok';
      } catch (err) {
        msg.textContent = 'Something went wrong. Please call ' + phone + '.'; msg.className = 'qmsg warn';
      }
    });
  })();
</script>

<style>
  .quote-form{display:grid;gap:1rem;background:#fff;border:1px solid var(--line);border-radius:14px;padding:1.6rem;box-shadow:var(--shadow)}
  .qrow{display:grid;gap:1rem}
  .qrow.two{grid-template-columns:1fr 1fr}
  .quote-form label{display:grid;gap:.35rem;font-size:.82rem;font-weight:700;color:var(--charcoal-deep);letter-spacing:.01em}
  .quote-form input,.quote-form select,.quote-form textarea{font:inherit;font-weight:400;padding:.68rem .72rem;border:1px solid var(--line);border-radius:8px;background:#fdfcfa;color:var(--ink)}
  .quote-form textarea{resize:vertical}
  .quote-form input:focus,.quote-form select:focus,.quote-form textarea:focus{outline:2px solid var(--red);outline-offset:1px;border-color:var(--red)}
  /* Present in the DOM (not display:none) so GoHighLevel's tracking script
     can still read it, but invisible and unreachable to real visitors. */
  .quote-form .visually-hidden{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
  .quote-form .btn{width:100%;text-align:center;border:none;cursor:pointer;margin-top:.2rem}
  .qfine{color:var(--muted);font-size:.82rem;margin:0}
  .qmsg{margin:.1rem 0 0;font-weight:700;font-size:.95rem}
  .qmsg.ok{color:#1f7a3d}
  .qmsg.warn{color:var(--red-dark)}
  @media(max-width:520px){.qrow.two{grid-template-columns:1fr}}
</style>
