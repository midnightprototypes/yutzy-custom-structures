---
import Layout from '../layouts/Layout.astro';
import { business, buildings, testimonials } from '../data/site';
import { gallery } from '../data/gallery';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import OverlayHero from '../components/OverlayHero.astro';
import PhotoLightbox from '../components/PhotoLightbox.astro';
const b = business;
const find = (slug: string) => buildings.find((x) => x.slug === slug)!;
const self = find('barndominiums');
const slab = find('slab-homes');
const postFrame = find('post-frame-homes');
const projects = gallery.filter((g) => g.type === 'barndominiums').slice(0, 6);
const review = testimonials.find((t) => t.name === 'Jacob McCoy')!;

const faqs = [
  { q: "Do I need to already have a floor plan?", a: "No. You can start the conversation before you have every detail figured out. Bring us what you know so far and we'll help you work through the project from there." },
  { q: "Can my barndominium include a shop or oversized garage?", a: "Yes. One of the biggest advantages of this style of home is the ability to plan living space and garage or shop space together." },
  { q: "Can I customize the floor plan?", a: "Yes. Layouts can be designed around your living-space needs, property, and how you plan to use the building." },
  { q: "Where does Yutzy build barndominiums?", a: "We serve customers across Kansas and Missouri from our Garnett, Kansas and Fordland, Missouri locations." },
  { q: "Do you offer financing?", a: "Financing options may be available for qualifying projects through Rural 1st." },
  { q: "How much does a barndominium cost?", a: "The cost depends on the home's size, layout, shop or garage space, finishes, site conditions, and overall project scope. The best place to start is by telling us what you're considering so we can help you understand the options." },
];
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
};
---
<Layout
  title={`${self.seoTitle} | ${b.name}`}
  description="Custom barndominiums designed around how you want to live, work and use your property — home, garage and shop under one roof. Built by Yutzy Custom Structures across Kansas & Missouri."
>
  <Breadcrumbs items={[{ label: 'What We Build', href: 'index.html#buildings' }, { label: 'Barndominiums' }]} />

  <OverlayHero
    eyebrow="Custom Barndominiums | Kansas + Missouri"
    title="Build the Home. Keep the Space."
    subtitle="Custom barndominiums designed around how you want to live, work and use your property. From open living spaces to attached shops and garages, Yutzy helps bring the entire building together."
    image="images/gallery/g01.webp"
    alt="Charcoal two-story barndominium with a covered wraparound porch, hanging flower baskets and a picnic table"
    ctaHref="index.html?type=Barndominium#contact"
    ctaText="Start Your Barndominium"
    ctaSecondaryText="See Barndominium Projects"
    ctaSecondaryHref="#projects"
    areaNote="Building Since 2005 · Kansas + Missouri · Custom Floor Plans · 5-Year Workmanship Warranty"
  />

  <!-- WHY A BARNDOMINIUM -->
  <section id="why">
    <div class="wrap">
      <div class="sec-head">
        <span class="eyebrow">Why a Barndominium?</span>
        <h2>Home, Garage, Shop. One Building Built Around You.</h2>
        <p>A barndominium gives you the freedom to combine comfortable living space with the extra room you want for vehicles, hobbies, equipment, work or storage — planned around how you actually use your property.</p>
      </div>
      <div class="cards">
        <article class="ocard">
          <img class="shot" src="images/gallery/g04.webp" alt="White two-story barndominium with twin roof cupolas and an attached carport" />
          <div class="ocard-body">
            <h3>Home + Garage</h3>
            <p>Comfortable living space with room for vehicles and storage, all under one roof.</p>
          </div>
        </article>
        <article class="ocard">
          <img class="shot" src="images/gallery/g06.webp" alt="Charcoal barndominium with stone wainscoting, a timber-frame entry and an attached three-bay shop" />
          <div class="ocard-body">
            <h3>Home + Shop</h3>
            <p>Keep work and hobbies close without giving up comfortable, finished living space.</p>
          </div>
        </article>
        <article class="ocard">
          <img class="shot" src="images/gallery/g23.webp" alt="Tan barndominium with a stone-clad timber-frame entry and an attached shop" />
          <div class="ocard-body">
            <h3>Home + Land</h3>
            <p>A home built to make sense for acreage and rural property, planned for how you'll use it for years to come.</p>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- DESIGNED AROUND YOU -->
  <section class="photo-band">
    <img class="photo-band-bg" src="images/gallery/g02.webp" alt="Bright red two-story barndominium with a stone-clad porch and a wood balcony off the upper level" />
    <div class="photo-band-scrim"></div>
    <div class="wrap photo-band-inner">
      <span class="eyebrow photo-band-eye">Your Home, Your Layout</span>
      <h2>Start With How You Want to Live.</h2>
      <p class="photo-band-lead">You don't have to walk in with a finished floor plan. Start with what matters most and we'll help work through how the spaces fit together — how many bedrooms, how much shop or garage space, whether it connects to the living area, a covered porch, room for an RV or oversized vehicles.</p>
      <a class="btn btn-red" href="index.html?type=Barndominium#contact">Talk Through Your Ideas</a>
    </div>
  </section>

  <!-- REAL PROJECTS -->
  <section id="projects" class="alt">
    <div class="wrap">
      <div class="sec-head">
        <span class="eyebrow">Barndominium Projects</span>
        <h2>See What We've Built.</h2>
        <p>Every property, floor plan and customer is different. Explore real Yutzy barndominiums for ideas on layout, exterior style, garages, shops and living space.</p>
      </div>
      <PhotoLightbox images={projects} />
      <p style="text-align:center;margin-top:1.8rem"><a class="btn btn-outline" href="gallery.html">View All Yutzy Projects</a></p>
    </div>
  </section>

  <!-- EXTERIOR -->
  <section>
    <div class="wrap split-grid">
      <div class="ph split-img"><img class="shot" src="images/gallery/g36.webp" alt="White barndominium with a covered porch and an attached two-bay shop" /></div>
      <div>
        <span class="eyebrow">From the Road</span>
        <h2>It Doesn't Have to Look Like a Barn.</h2>
        <p class="lead-p">Metal can be part of the look without defining the entire home. Mixed materials, rooflines, porches, windows and trim colors go into an exterior that feels like yours.</p>
        <ul class="checks">
          <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#955a22" stroke-width="2.4"><path d="M20 6L9 17l-5-5"/></svg> Metal siding with stone accents</li>
          <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#955a22" stroke-width="2.4"><path d="M20 6L9 17l-5-5"/></svg> Covered porches and varied rooflines</li>
          <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#955a22" stroke-width="2.4"><path d="M20 6L9 17l-5-5"/></svg> Custom trim, window and door styles</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- HOME + SHOP PLANNING -->
  <section class="alt">
    <div class="wrap">
      <div class="sec-head">
        <span class="eyebrow">Living + Working</span>
        <h2>Connected Doesn't Have to Mean Compromised.</h2>
        <p>The best home-and-shop layouts make both spaces work independently. Thoughtful placement of doors, walls, storage and traffic flow can help the living space feel like home while keeping the shop practical.</p>
      </div>
      <ul class="checks checks-grid">
        <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#955a22" stroke-width="2.4"><path d="M20 6L9 17l-5-5"/></svg> Where should the shop entrance be?</li>
        <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#955a22" stroke-width="2.4"><path d="M20 6L9 17l-5-5"/></svg> How much separation do you want between spaces?</li>
        <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#955a22" stroke-width="2.4"><path d="M20 6L9 17l-5-5"/></svg> What vehicles or equipment need access?</li>
        <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#955a22" stroke-width="2.4"><path d="M20 6L9 17l-5-5"/></svg> Where should mud, gear and storage go?</li>
      </ul>
      <p style="text-align:center;color:var(--muted);margin-top:1.6rem">You don't need all the answers yet — these are the kinds of details we'll help you work through.</p>
    </div>
  </section>

  <!-- WHAT'S BEHIND THE WALLS -->
  <section>
    <div class="wrap">
      <div class="sec-head">
        <span class="eyebrow">Built for More Than Curb Appeal</span>
        <h2>A Home Has to Perform as Good as It Looks.</h2>
        <p>Your barndominium isn't just a building shell. The structure, insulation, foundation and building envelope all affect how the home feels and performs long after construction is complete.</p>
      </div>
      <ul class="checks checks-grid">
        <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#955a22" stroke-width="2.4"><path d="M20 6L9 17l-5-5"/></svg> <span><b>Structure:</b> posts, framing and structural components sized to the home's design.</span></li>
        <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#955a22" stroke-width="2.4"><path d="M20 6L9 17l-5-5"/></svg> <span><b>Foundation:</b> a foundation system based on the home's design and site requirements.</span></li>
        <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#955a22" stroke-width="2.4"><path d="M20 6L9 17l-5-5"/></svg> <span><b>Insulation:</b> options designed around finished residential living.</span></li>
        <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#955a22" stroke-width="2.4"><path d="M20 6L9 17l-5-5"/></svg> <span><b>Roof + exterior:</b> durable materials with customizable colors and finishes.</span></li>
      </ul>
    </div>
  </section>

  <!-- PROCESS -->
  <section class="alt">
    <div class="wrap">
      <div class="sec-head">
        <span class="eyebrow">Your Barndominium, Step by Step</span>
        <h2>You Don't Have to Figure It All Out Before You Call.</h2>
        <p>Most projects start with an idea, not a finished set of plans. We'll help you work through the decisions in the right order.</p>
      </div>
      <ol class="process">
        <li><span class="pnum">01</span><h3>Tell Us About the Property</h3><p>Where you're building, what you already own and what you're envisioning.</p></li>
        <li><span class="pnum">02</span><h3>Talk Through the Home</h3><p>Living space, bedrooms, shop or garage needs, style and priorities.</p></li>
        <li><span class="pnum">03</span><h3>Layout + Planning</h3><p>Work through the size, configuration, selections and project scope.</p></li>
        <li><span class="pnum">04</span><h3>Finalize the Details</h3><p>Confirm your plans, options and construction details.</p></li>
        <li><span class="pnum">05</span><h3>Build Your Home</h3><p>The Yutzy team takes the project from plans to construction.</p></li>
      </ol>
    </div>
  </section>

  <!-- TESTIMONIAL -->
  <section>
    <div class="wrap">
      <div class="sec-head">
        <span class="eyebrow">Hear From Someone Who Built With Yutzy</span>
      </div>
      <div class="quotes" style="grid-template-columns:1fr;max-width:680px;margin:0 auto">
        <article class="quote">
          <div class="stars">{"★".repeat(review.stars)}</div>
          <p>&ldquo;{review.quote}&rdquo;</p>
          <p class="who">{review.name} · {review.source}</p>
        </article>
      </div>
    </div>
  </section>

  <!-- FINANCING -->
  <section class="alt">
    <div class="wrap" style="text-align:center">
      <span class="eyebrow">Financing</span>
      <h2>Planning a Home Means Planning the Investment, Too.</h2>
      <p style="color:var(--muted);max-width:560px;margin:0 auto 1.4rem">Financing options may be available for qualifying projects through Rural 1st.</p>
      <a class="btn btn-outline" href="index.html#contact">Explore Financing</a>
    </div>
  </section>

  <!-- COMPARE HOME TYPES -->
  <section>
    <div class="wrap">
      <div class="sec-head">
        <span class="eyebrow">Still Deciding</span>
        <h2>Not Sure Which Type of Home Fits You Best?</h2>
      </div>
      <div class="cards">
        <article class="ocard ocard-flat">
          <div class="ocard-body">
            <h3>Barndominium</h3>
            <p>A great option if you want residential living combined with a larger attached garage, shop or flexible-use space.</p>
            <span class="q">You're Here</span>
          </div>
        </article>
        <article class="ocard">
          <img class="shot" src={postFrame.img} alt={postFrame.alt} />
          <div class="ocard-body">
            <h3>{postFrame.name}</h3>
            <p>A flexible residential option for customers interested in post-frame construction with a custom-home feel.</p>
            <a class="q" href="post-frame-homes.html">Explore Post-Frame Homes →</a>
          </div>
        </article>
        <article class="ocard">
          <img class="shot" src={slab.img} alt={slab.alt} />
          <div class="ocard-body">
            <h3>{slab.name}</h3>
            <p>A strong fit if you want a traditional custom-home layout with everything on one level.</p>
            <a class="q" href="slab-homes.html">Explore Slab Homes →</a>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="alt">
    <div class="wrap faq-wrap">
      <div class="sec-head">
        <span class="eyebrow">Questions</span>
        <h2>Barndominium Questions</h2>
      </div>
      {faqs.map((f) => (
        <details class="faq-item">
          <summary>{f.q}</summary>
          <p class="faq-a">{f.a}</p>
        </details>
      ))}
    </div>
  </section>

  <!-- FINAL CTA -->
  <section class="final-cta">
    <img class="final-cta-bg" src="images/gallery/g01.webp" alt="" />
    <div class="final-cta-scrim"></div>
    <div class="wrap final-cta-inner">
      <h2>You Don't Need the Floor Plan Figured Out Yet.</h2>
      <p>Tell us what you're thinking about building, where your property is and anything you already know. We'll help you work through what comes next.</p>
      <div class="hero-cta">
        <a class="btn btn-red" href="index.html?type=Barndominium#contact">Start My Barndominium</a>
        <a class="btn btn-ghost" href={`tel:${b.phoneMainHref}`}>Call Yutzy</a>
      </div>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</Layout>

<style>
  .final-cta{position:relative;overflow:hidden;text-align:center;padding:clamp(4rem,10vw,6rem) 0}
  .final-cta-bg{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:0}
  .final-cta-scrim{position:absolute;inset:0;background:linear-gradient(rgba(30,35,33,.86),rgba(30,35,33,.9));z-index:1}
  .final-cta-inner{position:relative;z-index:2;color:#fff}
  .final-cta h2{font-size:clamp(1.9rem,4.5vw,2.7rem);margin:0 0 .8rem;max-width:20ch;margin-left:auto;margin-right:auto;color:#fff}
  .final-cta p{color:rgba(255,255,255,.86);max-width:56ch;margin:0 auto 1.8rem}
  .final-cta .hero-cta{justify-content:center}
</style>
