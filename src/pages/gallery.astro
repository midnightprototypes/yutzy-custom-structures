---
import Layout from '../layouts/Layout.astro';
import { gallery } from '../data/gallery';
---
<Layout
  title="Project Gallery | Yutzy Custom Structures"
  description="Browse finished pole barns, post-frame garages, hobby shops, and barndominiums built by Yutzy Custom Structures across Kansas & Missouri."
>
  <section class="pagehead">
    <div class="wrap">
      <span class="eyebrow" style="color:#f0d6ab">Our Work</span>
      <h1>Project Gallery</h1>
      <p>Real pole barns, garages, hobby shops, and barndominiums we've designed, delivered, and installed across Kansas &amp; Missouri.</p>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="gal-grid">
        {gallery.map((g) => (
          <a class="gal-item" href={g.src} target="_blank" rel="noopener">
            <img src={g.src} alt={g.alt} loading="lazy" />
          </a>
        ))}
      </div>
      <p style="text-align:center;margin-top:2.4rem">
        <a class="btn btn-red" href="index.html#contact">Get a Free Quote</a>
      </p>
    </div>
  </section>
</Layout>

<style>
  .gal-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(270px,1fr));gap:1rem}
  .gal-item{display:block;border-radius:12px;overflow:hidden;border:1px solid var(--line);aspect-ratio:3/2;background:#e9eee9}
  .gal-item img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .25s}
  .gal-item:hover img{transform:scale(1.05)}
</style>
