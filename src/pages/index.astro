---
import Layout from '../layouts/Layout.astro';
import { business, buildings, testimonials } from '../data/site';
const b = business;
const heroImg = "https://www.yutzyconstruction.com/wp-content/uploads/2024/07/Blank-Brian-32-815x600.jpg";
---
<Layout
  title={`Post-Frame & Pole Barn Builders in Kansas & Missouri | ${b.name}`}
  description="Family-owned Amish craftsmanship since 2005. Custom pole barns, garages, hobby shops & barndominiums across Kansas & Missouri. Get a free quote today."
>
  <!-- HERO -->
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <span class="eyebrow">Yutzy Custom Structures · Kansas &amp; Missouri</span>
        <h1>Post-Frame &amp; Pole Barn Builders Who Build It Right</h1>
        <p class="lede">Custom pole barns, garages, hobby shops, and barndominiums — crafted by a family-owned Amish team and backed by a 5-year warranty.</p>
        <div class="hero-cta">
          <a class="btn btn-red" href="#contact">Get a Free Quote</a>
          <a class="btn btn-ghost" href={`tel:${b.phoneMainHref}`}>Call {b.phoneMain}</a>
        </div>
      </div>
      <div class="ph"><img class="shot" src={heroImg} alt="Custom barn-style post-frame building with two garage doors and a covered porch, built by Yutzy" /></div>
    </div>
    <div class="badges">
      <div class="wrap">
        <div class="badge"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#c2924a" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg> Family-owned since 2005</div>
        <div class="badge"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#c2924a" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg> Authentic Amish craftsmanship</div>
        <div class="badge"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#c2924a" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg> 5-year warranty on every build</div>
        <div class="badge"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#c2924a" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg> Kansas &amp; Missouri</div>
      </div>
    </div>
  </section>

  <!-- BUILDING TYPES -->
  <section id="buildings">
    <div class="wrap">
      <div class="sec-head">
        <span class="eyebrow">What We Build</span>
        <h2>One team, every kind of post-frame building</h2>
        <p>From a simple hobby shop to a full barndominium — customized to your size, style, and budget.</p>
      </div>
      <div class="cards">
        {buildings.map((bld) => (
          <article class="card">
            <div class="ph"><img class="shot" src={bld.img} alt={bld.alt} /></div>
            <div class="card-body">
              <h3>{bld.name}</h3>
              <p>{bld.blurb}</p>
              <a class="q" href={`${bld.slug}.html`}>Learn more →</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- WHY YUTZY -->
  <section id="why" class="why">
    <div class="wrap">
      <div class="sec-head">
        <span class="eyebrow">Why Yutzy</span>
        <h2>Built sturdier, on purpose</h2>
        <p>More lumber and tighter post-and-truss spacing make a noticeably stronger building — crafted by a family-owned Amish team and backed by a 5-year warranty.</p>
      </div>
      <ul class="checks checks-grid">
        <li><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#a5322b" stroke-width="2.2"><circle cx="12" cy="12" r="10"/><path d="M8 12l3 3 5-6"/></svg><span><b>Amish craftsmanship.</b> A family-owned team that treats your build like their own.</span></li>
        <li><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#a5322b" stroke-width="2.2"><circle cx="12" cy="12" r="10"/><path d="M8 12l3 3 5-6"/></svg><span><b>More lumber, tighter spacing.</b> Closer post and truss spacing for a noticeably stronger building.</span></li>
        <li><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#a5322b" stroke-width="2.2"><circle cx="12" cy="12" r="10"/><path d="M8 12l3 3 5-6"/></svg><span><b>5-year warranty.</b> Real peace of mind, in writing, on every building.</span></li>
        <li><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#a5322b" stroke-width="2.2"><circle cx="12" cy="12" r="10"/><path d="M8 12l3 3 5-6"/></svg><span><b>Start to finish.</b> One team from first consult through final installation.</span></li>
        <li><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#a5322b" stroke-width="2.2"><circle cx="12" cy="12" r="10"/><path d="M8 12l3 3 5-6"/></svg><span><b>Financing available.</b> Build now and pay over time through Rural 1st, our preferred lending partner.</span></li>
      </ul>
    </div>
  </section>

  <!-- SERVICE AREA -->
  <section id="area" class="area">
    <div class="wrap">
      <span class="eyebrow" style="color:#f0d6ab">Where We Build</span>
      <h2>Proudly serving Kansas &amp; Missouri</h2>
      <p>Based in Garnett, KS, our crews build across both states — residential and commercial. If you're nearby, we'd love to give you a quote.</p>
      <a class="btn btn-red" href="#contact">Check My Area &amp; Get a Quote</a>
    </div>
  </section>

  <!-- TESTIMONIALS -->
  <section>
    <div class="wrap">
      <div class="sec-head">
        <span class="eyebrow">Customer Stories</span>
        <h2>What our customers say</h2>
        <p style="color:var(--muted);margin:0">Real reviews from our customers on Houzz. <a href={b.houzz} target="_blank" rel="noopener" style="color:var(--red-dark);font-weight:700">See all reviews →</a></p>
      </div>
      <div class="quotes">
        {testimonials.map((r) => (
          <div class="quote"><div class="stars">★★★★★</div><p>&ldquo;{r.quote}&rdquo;</p><div class="who">{r.name}</div></div>
        ))}
      </div>
    </div>
  </section>

  <!-- CONTACT / QUOTE -->
  <section id="contact" class="contact">
    <div class="wrap contact-grid">
      <div>
        <span class="eyebrow">Free Quote</span>
        <h2>Tell us about your project</h2>
        <p>Share a few details and our team will reach out with pricing and options. No pressure, no obligation.</p>
        <p>Prefer to talk? Call our main line:</p>
        <a class="call" href={`tel:${b.phoneMainHref}`}>
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#7f251f" stroke-width="2"><path d="M22 16.9v3a2 2 0 01-2.2 2 19.8 19.8 0 01-8.6-3 19.5 19.5 0 01-6-6 19.8 19.8 0 01-3-8.6A2 2 0 014.1 2h3a2 2 0 012 1.7c.1.9.3 1.8.6 2.6a2 2 0 01-.5 2.1L8.1 9.9a16 16 0 006 6l1.5-1.1a2 2 0 012.1-.5c.8.3 1.7.5 2.6.6a2 2 0 011.7 2z"/></svg>
          {b.phoneMain}
        </a>
        <div class="local">
          <div><b>Missouri office:</b> <a href={`tel:${b.phoneMOHref}`}>{b.phoneMO}</a></div>
        </div>
        <p class="fineprint">{b.hours} · {b.address.street}, {b.address.city}, {b.address.region} {b.address.zip}</p>
      </div>
      <div>
        {b.ghlFormEmbedUrl ? (
          <div class="form-wrap">
            <iframe src={b.ghlFormEmbedUrl} style="width:100%;height:640px;border:none;border-radius:14px;background:#fff" title="Get a free quote" loading="lazy"></iframe>
            <script src="https://link.msgsndr.com/js/form_embed.js" is:inline defer></script>
          </div>
        ) : (
          <div class="form-slot">
            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#a5322b" stroke-width="1.6"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M7 9h10M7 13h6"/></svg>
            <b>Your GoHighLevel quote form goes here</b>
            <p>Paste the GHL form embed URL into <code>src/data/site.ts</code> and it appears here — leads flow straight into your CRM.<br />Fields: Name · Phone · Email · <b>Project location (KS / MO)</b> · Project type</p>
          </div>
        )}
      </div>
    </div>
  </section>
</Layout>
