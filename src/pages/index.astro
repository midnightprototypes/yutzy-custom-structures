---
import Layout from '../layouts/Layout.astro';
import { business, buildings, testimonials } from '../data/site';
import OverlayHero from '../components/OverlayHero.astro';
import FeatureCards from '../components/FeatureCards.astro';
import QuoteForm from '../components/QuoteForm.astro';
import DocPreview from '../components/DocPreview.astro';
import ReviewCarousel from '../components/ReviewCarousel.astro';
const b = business;
const heroImg = "images/hero.webp";
---
<Layout
  title={`Post-Frame & Pole Barn Builders in Kansas & Missouri | ${b.name}`}
  description="Family-owned Amish craftsmanship since 2005. Custom pole barns, garages, hobby shops & barndominiums across Kansas & Missouri. Get a free quote today."
>
  <!-- HERO (full-bleed overlay) -->
  <OverlayHero
    eyebrow="Yutzy Custom Structures · Kansas & Missouri"
    title="Post-Frame & Pole Barn Builders Who Build It Right"
    subtitle="Custom pole barns, garages, hobby shops, and barndominiums — crafted by a family-owned Amish team and backed by a 5-year warranty."
    image={heroImg}
    alt="Custom barn-style post-frame building with two garage doors and a covered porch, built by Yutzy"
    ctaHref="#contact"
  />
  <section class="trust-strip">
    <div class="wrap badges-row">
      <div class="badge"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#c2924a" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg> Family-owned since 2005</div>
      <div class="badge"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#c2924a" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg> Authentic Amish craftsmanship</div>
      <div class="badge"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#c2924a" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg> 5-year warranty on every build</div>
      <div class="badge"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#c2924a" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg> Kansas &amp; Missouri</div>
    </div>
  </section>

  <!-- BUILDING TYPES -->
  <section id="buildings">
    <div class="wrap">
      <div class="sec-head">
        <span class="eyebrow">What We Build</span>
        <h2>One team, every kind of post-frame building</h2>
        <p>From a simple hobby shop to a full barndominium — customized to your size, style, and budget.</p>
      </div>
      <div class="cards">
        {buildings.map((bld) => (
          <article class="card">
            <div class="ph"><img class="shot" src={bld.img} alt={bld.alt} /></div>
            <div class="card-body">
              <h3>{bld.name}</h3>
              <p>{bld.blurb}</p>
              <a class="q" href={`${bld.slug}.html`}>Learn more →</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- WHY YUTZY -->
  <section id="why" class="why">
    <div class="wrap">
      <div class="sec-head">
        <span class="eyebrow">Why Yutzy</span>
        <h2>Built sturdier, on purpose</h2>
        <p>More lumber and tighter post-and-truss spacing make a noticeably stronger building — crafted by a family-owned Amish team and backed by a 5-year warranty.</p>
      </div>
      <FeatureCards items={[
        { icon: 'craft', title: 'Amish Craftsmanship', text: 'A family-owned team that treats your build like their own.' },
        { icon: 'award', title: '5-Year Warranty', text: 'Real peace of mind, in writing, on every building.' },
        { icon: 'finance', title: 'Flexible Financing', text: 'Build now and pay over time through Rural 1st.' },
        { icon: 'service', title: 'Start to Finish', text: 'One team from first consult through final installation.' },
      ]} />
    </div>
  </section>

  <!-- CUSTOMIZE YOUR LOOK -->
  <section id="customize">
    <div class="wrap">
      <div class="sec-head">
        <span class="eyebrow">Make It Yours</span>
        <h2>Customize your building's look</h2>
        <p>Pick from a wide range of paint &amp; stain finishes, metal colors, and custom features so your building looks as good as it lasts.</p>
      </div>
      <div class="cards">
        <article class="card">
          <div class="ph"><img class="shot" src="images/customize-paint.webp" alt="Stained wood post-frame building" /></div>
          <div class="card-body">
            <h3>Paint &amp; Stain</h3>
            <p>Premium paint and stain options for a fresh, lasting look with excellent weather resistance.</p>
            <a class="q doc-open" href="docs/paint-and-stain-colors.pdf" data-img="images/chart-paint.webp" data-pdf="docs/paint-and-stain-colors.pdf" data-title="Paint &amp; Stain Colors">View Paint &amp; Stain Colors →</a>
          </div>
        </article>
        <article class="card">
          <div class="ph"><img class="shot" src="images/customize-metal.webp" alt="Metal-roof post-frame building" /></div>
          <div class="card-body">
            <h3>Metal Colors</h3>
            <p>A wide range of durable, fade-resistant metal roof and siding colors to match your style.</p>
            <a class="q doc-open" href="docs/metal-colors.pdf" data-img="images/chart-metal.webp" data-pdf="docs/metal-colors.pdf" data-title="Metal Colors">View Metal Colors →</a>
          </div>
        </article>
        <article class="card">
          <div class="ph"><img class="shot" src="images/customize-options.webp" alt="Custom-finished building with windows and trim" /></div>
          <div class="card-body">
            <h3>Customization Options</h3>
            <p>Personalize windows, doors, trim, and layout so the building fits exactly what you need.</p>
            <a class="q doc-open" href="docs/customization-options.pdf" data-img="images/chart-options.webp" data-pdf="docs/customization-options.pdf" data-title="Customization Options">View Customization Options →</a>
          </div>
        </article>
      </div>
      <DocPreview />
    </div>
  </section>

  <!-- SERVICE AREA -->
  <section id="area" class="area area-band">
    <div class="wrap">
      <span class="eyebrow" style="color:#f0d6ab">Where We Build</span>
      <h2>Proudly serving Kansas &amp; Missouri</h2>
      <p>Based in Garnett, KS, our crews build across both states — residential and commercial. If you're nearby, we'd love to give you a quote.</p>
      <a class="btn btn-red" href="#contact">Check My Area &amp; Get a Quote</a>
    </div>
  </section>

  <!-- TESTIMONIALS -->
  <section>
    <div class="wrap">
      <div class="sec-head">
        <span class="eyebrow">Customer Stories</span>
        <h2>What our customers say</h2>
        <p style="color:var(--muted);margin:0 0 1.1rem">Real reviews from customers across Kansas &amp; Missouri.</p>
        <div class="rev-badges">
          <a class="rev-badge" href={b.google.url} target="_blank" rel="noopener" aria-label={`${b.google.rating} out of 5 on Google`}>
            <svg class="rev-g" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path fill="#4285F4" d="M23 12.3c0-.8-.1-1.6-.2-2.3H12v4.5h6.2a5.3 5.3 0 01-2.3 3.5v2.9h3.7C21.8 18.9 23 15.9 23 12.3z"/><path fill="#34A853" d="M12 24c3.1 0 5.7-1 7.6-2.8l-3.7-2.9c-1 .7-2.3 1.1-3.9 1.1-3 0-5.5-2-6.4-4.7H1.8v3C3.7 21.4 7.5 24 12 24z"/><path fill="#FBBC05" d="M5.6 14.3a7.2 7.2 0 010-4.6v-3H1.8a12 12 0 000 10.6l3.8-3z"/><path fill="#EA4335" d="M12 4.8c1.7 0 3.2.6 4.4 1.7l3.3-3.3C17.7 1.2 15.1 0 12 0 7.5 0 3.7 2.6 1.8 6.4l3.8 3C6.5 6.7 9 4.8 12 4.8z"/></svg>
            <b class="rev-rating">{b.google.rating}</b>
            <span class="rev-stars" style={`--pct:${(Number(b.google.rating) / 5 * 100).toFixed(0)}%`} aria-hidden="true"></span>
            <span class="rev-count">Read our Google reviews →</span>
          </a>
          <a class="rev-badge alt" href={b.houzz} target="_blank" rel="noopener">Houzz reviews →</a>
        </div>
      </div>
      <ReviewCarousel reviews={testimonials} />
    </div>
  </section>

  <!-- CONTACT / QUOTE -->
  <section id="contact" class="contact">
    <div class="wrap contact-grid">
      <div>
        <span class="eyebrow">Free Quote</span>
        <h2>Tell us about your project</h2>
        <p>Share a few details and our team will reach out with pricing and options. No pressure, no obligation.</p>
        <p>Prefer to talk? Call our main line:</p>
        <a class="call" href={`tel:${b.phoneMainHref}`}>
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#955a22" stroke-width="2"><path d="M22 16.9v3a2 2 0 01-2.2 2 19.8 19.8 0 01-8.6-3 19.5 19.5 0 01-6-6 19.8 19.8 0 01-3-8.6A2 2 0 014.1 2h3a2 2 0 012 1.7c.1.9.3 1.8.6 2.6a2 2 0 01-.5 2.1L8.1 9.9a16 16 0 006 6l1.5-1.1a2 2 0 012.1-.5c.8.3 1.7.5 2.6.6a2 2 0 011.7 2z"/></svg>
          {b.phoneMain}
        </a>
        <div class="local">
          <div><b>Missouri office:</b> <a href={`tel:${b.phoneMOHref}`}>{b.phoneMO}</a></div>
        </div>
        <p class="fineprint">{b.hours} · {b.address.street}, {b.address.city}, {b.address.region} {b.address.zip}</p>
      </div>
      <div>
        <QuoteForm />
      </div>
    </div>
  </section>
</Layout>

<style>
  .rev-badges{display:flex;flex-wrap:wrap;gap:.7rem;justify-content:center}
  .rev-badge{display:inline-flex;align-items:center;gap:.5rem;background:#fff;border:1px solid var(--line);border-radius:999px;padding:.5rem .95rem;text-decoration:none;color:var(--ink);font-weight:600;font-size:.95rem;box-shadow:0 1px 0 rgba(0,0,0,.03)}
  .rev-badge:hover{border-color:var(--red)}
  .rev-badge.alt{color:var(--red-deep)}
  .rev-rating{font-family:var(--font-head);font-size:1.05rem;color:var(--charcoal-deep)}
  .rev-stars{position:relative;display:inline-block;font-size:1rem;line-height:1;letter-spacing:1px}
  .rev-stars::before{content:"★★★★★";color:#d9d2c4}
  .rev-stars::after{content:"★★★★★";color:var(--gold);position:absolute;left:0;top:0;width:var(--pct);overflow:hidden;white-space:nowrap}
  .rev-count{color:var(--muted)}
</style>
