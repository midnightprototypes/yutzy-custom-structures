---
import Layout from '../layouts/Layout.astro';
import { business, buildings, testimonials } from '../data/site';
import OverlayHero from '../components/OverlayHero.astro';
import FeatureCards from '../components/FeatureCards.astro';
import QuoteForm from '../components/QuoteForm.astro';
import DocPreview from '../components/DocPreview.astro';
import ReviewCarousel from '../components/ReviewCarousel.astro';
const b = business;
const heroImg = "images/hero.webp";

const find = (slug: string) => buildings.find((x) => x.slug === slug)!;
const barndo = find('barndominiums');
const slab = find('slab-homes');
const poleBarn = find('pole-barns');
const hobbyShop = find('hobby-shops');

const faqHighlights = [
  { q: "How much does it cost?", a: "It depends on size, height, doors, insulation, and finish level, so there's no single price. Tell us what you're picturing and we'll help you work through real numbers." },
  { q: "Do you offer financing?", a: "Yes. We partner with Rural 1st so you can build now and pay over time." },
  { q: "What areas do you serve?", a: "We build across Kansas and Missouri from our locations in Garnett, KS and Fordland, MO." },
  { q: "Do you deliver and install, or is it a kit?", a: "We design, deliver, and install with our own crews from start to finish. You're not buying a kit to assemble yourself." },
];
---
<Layout
  title={`Custom Structures Across Kansas & Missouri | ${b.name}`}
  description="Custom homes, barndominiums, shops, barns and commercial buildings built across Kansas & Missouri since 2005. Family-owned, 5-year workmanship warranty."
>
  <!-- HERO -->
  <OverlayHero
    eyebrow="Custom Structures Across Kansas + Missouri"
    title="Built Around How You Actually Live."
    subtitle="Custom homes, barndominiums, shops, barns, and commercial buildings built around your land, your plans, and what you need the building to do."
    image={heroImg}
    alt="Post-frame building with exposed timber-frame gables, stone wainscoting and warm exterior lighting at dusk, built by Yutzy Custom Structures"
    ctaHref="#contact"
    ctaText="Start Your Project"
    ctaSecondaryText="Explore What We Build"
    ctaSecondaryHref="#buildings"
    areaNote="Serving customers from Garnett, Kansas and Fordland, Missouri."
    areaNoteHref="#area"
  />
  <section class="trust-strip">
    <div class="wrap badges-row">
      <div class="badge"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#c2924a" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg> Building Since 2005</div>
      <div class="badge"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#c2924a" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg> Kansas &amp; Missouri</div>
      <div class="badge"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#c2924a" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg> 5-Year Workmanship Warranty</div>
    </div>
  </section>

  <!-- WHAT ARE YOU LOOKING TO BUILD? -->
  <section id="buildings">
    <div class="wrap">
      <div class="sec-head">
        <span class="eyebrow">What We Build</span>
        <h2>What Are You Looking to Build?</h2>
        <p>Start with what you need the space to do. We'll help with the rest.</p>
      </div>
      <div class="intent-grid">
        <article class="ocard">
          <img class="shot" src="images/gallery/g44.webp" alt="Elegant post-frame home with a stone-columned covered porch and timber-frame entry" />
          <div class="ocard-body">
            <h3>Homes</h3>
            <p>Planned around how you actually live.</p>
            <p class="ocard-links"><a href="barndominiums.html">Barndominiums</a> · <a href="post-frame-homes.html">Post-Frame Homes</a> · <a href="slab-homes.html">Slab Homes →</a></p>
          </div>
        </article>
        <article class="ocard">
          <img class="shot" src="images/gallery/g28.webp" alt="Tan and brown two-car garage with a Yutzy nameplate on the peak" />
          <div class="ocard-body">
            <h3>Shops &amp; Garages</h3>
            <p>Room for the vehicles, tools and projects you've outgrown.</p>
            <p class="ocard-links"><a href="post-frame-garages.html">Garages</a> · <a href="hobby-shops.html">Hobby Shops →</a></p>
          </div>
        </article>
        <article class="ocard">
          <img class="shot" src="images/gallery/g20.webp" alt="Gray equestrian barn with three horses sheltered under an open lean-to" />
          <div class="ocard-body">
            <h3>Farm Buildings</h3>
            <p>Built around your equipment, livestock and acreage.</p>
            <p class="ocard-links"><a href="pole-barns.html">Pole Barns</a> · <a href="equestrian-barns.html">Equestrian Barns →</a></p>
          </div>
        </article>
        <article class="ocard">
          <img class="shot" src="images/gallery/g29.webp" alt="Gray three-bay garage with a covered entry and landscaped stone accents" />
          <div class="ocard-body">
            <h3>Commercial Buildings</h3>
            <p>Built around how your business operates.</p>
            <a class="q" href="index.html?type=Not+sure+yet#contact">Talk Through a Project →</a>
          </div>
        </article>
      </div>
      <p class="not-sure">
        <b>Not sure what you need? That's okay.</b>
        Tell us what you're trying to accomplish and we'll help you figure out the right building.
        <a class="q" href="index.html?type=Not+sure+yet#contact">Talk Through My Project →</a>
      </p>
    </div>
  </section>

  <!-- WHY YUTZY -->
  <section id="why" class="alt">
    <div class="wrap">
      <div class="sec-head">
        <span class="eyebrow">Why Yutzy</span>
        <h2>Big Enough to Handle the Build.<br />Small Enough to Know Yours.</h2>
        <p>Yutzy Custom Structures has been building across Kansas and Missouri since 2005. From the first conversation through construction, our team stays focused on the details that make the finished building work for you.</p>
        <p class="rev-inline"><a href={b.google.url} target="_blank" rel="noopener">★ {b.google.rating} from {b.google.count} Google reviews →</a></p>
      </div>
      <FeatureCards items={[
        { icon: 'award', title: 'Building Since 2005', text: 'Over twenty years of hands-on construction across Kansas and Missouri.' },
        { icon: 'craft', title: 'Family-Owned, Amish Craftsmanship', text: 'A family-owned team that treats your build like their own.' },
        { icon: 'service', title: 'Start to Finish', text: 'One team guiding your project from the first conversation through construction: design, delivery and installation, all handled in-house.' },
        { icon: 'ruler', title: '5-Year Warranty', text: 'Real peace of mind, in writing, on every building.' },
      ]} />
    </div>
  </section>

  <!-- CONSTRUCTION QUALITY -->
  <section class="ch-hero rotator" id="buildRotator">
    <img class="ch-bg rot-img active" src="images/gallery/g17.webp" alt="Large open-bay pole barn under construction, showing the post-frame structure" />
    <img class="ch-bg rot-img" src="images/gallery/g11.webp" alt="Open-sided pole barn with visible post and truss framing" />
    <img class="ch-bg rot-img" src="images/gallery/g16.webp" alt="Finished red and white pole barn at dusk" />
    <img class="ch-bg rot-img" src="images/gallery/g45.webp" alt="Finished white pole barn with red trim and an open drive-through bay" />
    <div class="ch-scrim"></div>
    <div class="wrap ch-inner">
      <span class="eyebrow ch-eye">How We Build</span>
      <h2 class="ch-h2">What's Behind a Yutzy Building.</h2>
      <p class="ch-lead">A finished building can look good from the road. What matters just as much is what holds it up.</p>
      <ul class="checks checks-light">
        <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#f0d6ab" stroke-width="2.4"><path d="M20 6L9 17l-5-5"/></svg> <span><b>Tighter post &amp; truss spacing:</b> more lumber and closer spacing than a typical post-frame build.</span></li>
        <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#f0d6ab" stroke-width="2.4"><path d="M20 6L9 17l-5-5"/></svg> <span><b>Built by our own crews:</b> delivered and installed in-house, never handed off to a subcontractor.</span></li>
        <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#f0d6ab" stroke-width="2.4"><path d="M20 6L9 17l-5-5"/></svg> <span><b>Sized and configured around you:</b> built to your exact dimensions, not pulled from a set catalog page.</span></li>
        <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#f0d6ab" stroke-width="2.4"><path d="M20 6L9 17l-5-5"/></svg> <span><b>Backed in writing:</b> a 5-year workmanship warranty on every build.</span></li>
      </ul>
    </div>
  </section>

  <!-- FEATURED PROJECTS -->
  <section>
    <div class="wrap">
      <div class="sec-head">
        <span class="eyebrow">Real Yutzy Projects</span>
        <h2>See What We've Built.</h2>
        <p>Homes, shops, barns and custom spaces built for real customers across Kansas &amp; Missouri.</p>
      </div>
      <div class="cards proj-cards">
        <article class="ocard">
          <img class="shot" src="images/gallery/g02.webp" alt="Bright red two-story barndominium with a stone-clad porch and a wood balcony off the upper level" />
          <div class="ocard-body">
            <h3>Barndominium</h3>
            <p>{barndo.blurb}</p>
            <a class="q" href="barndominiums.html">Explore Barndominiums →</a>
          </div>
        </article>
        <article class="ocard">
          <img class="shot" src="images/gallery/g16.webp" alt="Red and white pole barn with a split roofline at dusk" />
          <div class="ocard-body">
            <h3>Pole Barn</h3>
            <p>{poleBarn.blurb}</p>
            <a class="q" href="pole-barns.html">Explore Pole Barns →</a>
          </div>
        </article>
        <article class="ocard">
          <img class="shot" src="images/gallery/g26.webp" alt="Navy and white pool house with a covered porch and hanging flower baskets beside an in-ground pool" />
          <div class="ocard-body">
            <h3>Hobby Shop</h3>
            <p>{hobbyShop.blurb}</p>
            <a class="q" href="hobby-shops.html">Explore Hobby Shops →</a>
          </div>
        </article>
        <article class="ocard">
          <img class="shot" src="images/gallery/g33.webp" alt="Gray slab home with a full-length covered porch and stone-clad columns" />
          <div class="ocard-body">
            <h3>Slab Home</h3>
            <p>{slab.blurb}</p>
            <a class="q" href="slab-homes.html">Explore Slab Homes →</a>
          </div>
        </article>
      </div>
      <p style="text-align:center;margin-top:1.8rem"><a class="btn btn-outline" href="gallery.html">View More Yutzy Projects</a></p>
    </div>
  </section>

  <!-- CUSTOMER PROOF -->
  <section class="alt">
    <div class="wrap">
      <div class="sec-head">
        <span class="eyebrow">Customer Stories</span>
        <h2>Hear From People We've Built&nbsp;For.</h2>
        <p>Real projects. Real customers. Real experiences with the Yutzy team.</p>
      </div>
      <div class="rev-badges">
        <a class="rev-badge" href={b.google.url} target="_blank" rel="noopener" aria-label={`${b.google.rating} out of 5 on Google`}>
          <svg class="rev-g" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path fill="#4285F4" d="M23 12.3c0-.8-.1-1.6-.2-2.3H12v4.5h6.2a5.3 5.3 0 01-2.3 3.5v2.9h3.7C21.8 18.9 23 15.9 23 12.3z"/><path fill="#34A853" d="M12 24c3.1 0 5.7-1 7.6-2.8l-3.7-2.9c-1 .7-2.3 1.1-3.9 1.1-3 0-5.5-2-6.4-4.7H1.8v3C3.7 21.4 7.5 24 12 24z"/><path fill="#FBBC05" d="M5.6 14.3a7.2 7.2 0 010-4.6v-3H1.8a12 12 0 000 10.6l3.8-3z"/><path fill="#EA4335" d="M12 4.8c1.7 0 3.2.6 4.4 1.7l3.3-3.3C17.7 1.2 15.1 0 12 0 7.5 0 3.7 2.6 1.8 6.4l3.8 3C6.5 6.7 9 4.8 12 4.8z"/></svg>
          <b class="rev-rating">{b.google.rating}</b>
          <span class="rev-stars" style={`--pct:${(Number(b.google.rating) / 5 * 100).toFixed(0)}%`} aria-hidden="true"></span>
          <span class="rev-count">Read our Google reviews →</span>
        </a>
        <a class="rev-badge rev-badge-outline" href={b.houzz} target="_blank" rel="noopener">Houzz reviews →</a>
        <a class="rev-badge rev-badge-outline" href={b.google.writeReviewUrl} target="_blank" rel="noopener">Leave us a review →</a>
      </div>
      <ReviewCarousel reviews={testimonials} />
    </div>
  </section>

  <!-- MAKE IT YOURS -->
  <section id="customize">
    <div class="wrap">
      <div class="sec-head">
        <span class="eyebrow">Make It Yours</span>
        <h2>The Building Is Only the Beginning.</h2>
        <p>Choose the colors, doors, windows, trim and finishing details that make the building feel like it belongs on your property.</p>
      </div>
      <div class="cards">
        <article class="ocard">
          <img class="shot" src="images/customize-paint.webp" alt="Stained wood post-frame building" />
          <div class="ocard-body">
            <h3>Paint &amp; Stain</h3>
            <p>Premium finishes that hold up to Midwest weather.</p>
            <a class="q doc-open" href="docs/paint-and-stain-colors.pdf" data-img="images/chart-paint.webp" data-pdf="docs/paint-and-stain-colors.pdf" data-title="Paint &amp; Stain Colors">View Paint &amp; Stain Colors →</a>
          </div>
        </article>
        <article class="ocard">
          <img class="shot" src="images/customize-metal.webp" alt="Metal-roof post-frame building" />
          <div class="ocard-body">
            <h3>Metal Colors</h3>
            <p>Durable, fade-resistant roof and siding colors.</p>
            <a class="q doc-open" href="docs/metal-colors.pdf" data-img="images/chart-metal.webp" data-pdf="docs/metal-colors.pdf" data-title="Metal Colors">View Metal Colors →</a>
          </div>
        </article>
        <article class="ocard">
          <img class="shot" src="images/customize-options.webp" alt="Custom-finished building with windows and trim" />
          <div class="ocard-body">
            <h3>Customization Options</h3>
            <p>Windows, doors, trim and layout, personalized to fit.</p>
            <a class="q doc-open" href="docs/customization-options.pdf" data-img="images/chart-options.webp" data-pdf="docs/customization-options.pdf" data-title="Customization Options">View Customization Options →</a>
          </div>
        </article>
      </div>
      <DocPreview />
    </div>
  </section>

  <!-- PROCESS -->
  <section id="process" class="alt">
    <div class="wrap">
      <div class="sec-head">
        <span class="eyebrow">How It Works</span>
        <h2>From Idea to Finished Building.</h2>
        <p>You don't need every detail figured out before you call us. That's what the first conversation is for.</p>
      </div>
      <ol class="process">
        <li><span class="pnum">01</span><h3>Tell Us What You're Thinking</h3><p>Share what you want to build, where you're building, and anything you already know.</p></li>
        <li><span class="pnum">02</span><h3>Talk Through the Project</h3><p>We'll discuss the property, priorities, building type and what you need the space to do.</p></li>
        <li><span class="pnum">03</span><h3>Design + Estimate</h3><p>Work through size, layout, options and pricing.</p></li>
        <li><span class="pnum">04</span><h3>Finalize the Details</h3><p>Confirm the scope, selections and project plan.</p></li>
        <li><span class="pnum">05</span><h3>We Build</h3><p>Our team gets to work turning the plan into your finished structure.</p></li>
      </ol>
    </div>
  </section>

  <!-- LOCATIONS -->
  <section id="area">
    <div class="wrap">
      <div class="sec-head">
        <span class="eyebrow">Where We Build</span>
        <h2>Two Locations. One Yutzy Standard.</h2>
        <p>With crews serving both states, Yutzy builds across the region from two local hubs.</p>
      </div>
      <div class="loc-grid">
        <article class="loc-card">
          <div class="loc-map">
            <iframe src={b.google.mapEmbedUrl} loading="lazy" referrerpolicy="no-referrer-when-downgrade" title="Map to Yutzy Custom Structures, Garnett, KS"></iframe>
          </div>
          <div class="loc-body">
            <h3>Garnett, Kansas</h3>
            <p>{b.address.street}<br />{b.address.city}, {b.address.region} {b.address.zip}</p>
            <p><a class="call-inline" href={`tel:${b.phoneMainHref}`}>{b.phoneMain}</a> · {b.hours}</p>
            <p><a class="q" href={b.google.directionsUrl} target="_blank" rel="noopener">Get Directions →</a></p>
          </div>
        </article>
        <article class="loc-card">
          <div class="loc-map">
            <iframe src={b.fordland.mapEmbedUrl} loading="lazy" referrerpolicy="no-referrer-when-downgrade" title="Map to Yutzy Custom Structures, Fordland, MO"></iframe>
          </div>
          <div class="loc-body">
            <h3>Fordland, Missouri</h3>
            <p>{b.fordland.street}<br />{b.fordland.city}, {b.fordland.region} {b.fordland.zip}</p>
            <p><a class="call-inline" href={`tel:${b.phoneMOHref}`}>{b.phoneMO}</a></p>
            <p><a class="q" href={b.fordland.directionsUrl} target="_blank" rel="noopener">Get Directions →</a></p>
          </div>
        </article>
      </div>
      <p class="dm-note">
        Need something simpler? Our sister company <b>{b.dmMiniBarns.name}</b> builds sheds and portable buildings at both locations:
        {b.dmMiniBarns.locations.map((loc, i) => (
          <>
            {i > 0 && ' · '}
            <a href={loc.directionsUrl} target="_blank" rel="noopener">{loc.city}, {loc.region} →</a>
          </>
        ))}
      </p>
    </div>
  </section>

  <!-- FINANCING -->
  <section class="financing">
    <div class="wrap">
      <span class="eyebrow" style="color:#f0d6ab">Financing</span>
      <h2>A Bigger Project Doesn't Have to Mean One Big Payment.</h2>
      <p>Financing options are available for qualifying projects through Rural 1st.</p>
      <a class="btn btn-red" href="index.html#contact">Talk Through Financing</a>
    </div>
  </section>

  <!-- CONTACT / PROJECT INQUIRY -->
  <section id="contact" class="contact">
    <div class="wrap contact-grid">
      <div>
        <span class="eyebrow">Start Your Project</span>
        <h2>Tell Us What You're Thinking.</h2>
        <p>You don't need plans, exact dimensions or every decision made. Give us a few details and we'll help you figure out the next step.</p>
        <p>Prefer to talk? Call our main line:</p>
        <a class="call" href={`tel:${b.phoneMainHref}`}>
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#955a22" stroke-width="2"><path d="M22 16.9v3a2 2 0 01-2.2 2 19.8 19.8 0 01-8.6-3 19.5 19.5 0 01-6-6 19.8 19.8 0 01-3-8.6A2 2 0 014.1 2h3a2 2 0 012 1.7c.1.9.3 1.8.6 2.6a2 2 0 01-.5 2.1L8.1 9.9a16 16 0 006 6l1.5-1.1a2 2 0 012.1-.5c.8.3 1.7.5 2.6.6a2 2 0 011.7 2z"/></svg>
          {b.phoneMain}
        </a>
        <div class="local">
          <div><b>Missouri office:</b> <a href={`tel:${b.phoneMOHref}`}>{b.phoneMO}</a></div>
        </div>
        <p class="fineprint">{b.hours} · {b.address.street}, {b.address.city}, {b.address.region} {b.address.zip}</p>
      </div>
      <div>
        <QuoteForm />
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section>
    <div class="wrap faq-wrap">
      <div class="sec-head">
        <span class="eyebrow">Questions</span>
        <h2>Common Questions</h2>
      </div>
      {faqHighlights.map((f) => (
        <details class="faq-item">
          <summary>{f.q}</summary>
          <p class="faq-a">{f.a}</p>
        </details>
      ))}
      <p style="text-align:center;margin-top:1.6rem"><a class="q" href="faq.html">See All FAQs →</a></p>
    </div>
  </section>

  <!-- FINAL CTA -->
  <section class="final-cta">
    <img class="final-cta-bg" src="images/gallery/g11.webp" alt="" />
    <div class="final-cta-scrim"></div>
    <div class="wrap final-cta-inner">
      <h2>You Don't Need Every Detail Figured Out Yet.</h2>
      <p>Tell us what you're thinking about building. We'll help you work through the options, the project and what comes next.</p>
      <div class="hero-cta">
        <a class="btn btn-red" href="index.html#contact">Start Your Project</a>
        <a class="btn btn-ghost" href={`tel:${b.phoneMainHref}`}>Call Yutzy</a>
      </div>
    </div>
  </section>

  <script is:inline>
    (function () {
      var wrap = document.getElementById('buildRotator');
      if (!wrap) return;
      var imgs = wrap.querySelectorAll('.rot-img');
      if (imgs.length < 2) return;
      var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (reduce) return;
      var i = 0;
      setInterval(function () {
        imgs[i].classList.remove('active');
        i = (i + 1) % imgs.length;
        imgs[i].classList.add('active');
      }, 4000);
    })();
  </script>
</Layout>

<style>
  .rev-inline{margin:.6rem 0 0}
  .rev-inline a{color:var(--red-deep);font-weight:700;text-decoration:none}
  .rev-badges{display:flex;flex-wrap:wrap;gap:.7rem;justify-content:center;margin-bottom:2.2rem}
  .rev-badge{display:inline-flex;align-items:center;gap:.5rem;background:#fff;border:1px solid var(--line);border-radius:999px;padding:.5rem .95rem;text-decoration:none;color:var(--ink);font-weight:600;font-size:.95rem;box-shadow:0 1px 0 rgba(0,0,0,.03)}
  .rev-badge:hover{border-color:var(--red)}
  .rev-badge-outline{color:var(--red-deep)}
  .rev-rating{font-family:var(--font-head);font-size:1.05rem;color:var(--charcoal-deep)}
  .rev-stars{position:relative;display:inline-block;font-size:1rem;line-height:1;letter-spacing:1px}
  .rev-stars::before{content:"★★★★★";color:#d9d2c4}
  .rev-stars::after{content:"★★★★★";color:var(--gold);position:absolute;left:0;top:0;width:var(--pct);overflow:hidden;white-space:nowrap}
  .rev-count{color:var(--muted)}

  /* Intent-first "what are you building" grid — four even paths, deliberately equal weight */
  .intent-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:1.4rem}
  /* .ocard (overlay photo cards) lives in Layout.astro — shared with the
     building pages. Only the grid that lays them out is page-specific. */
  .not-sure{max-width:640px;margin:2.4rem auto 0;text-align:center;color:var(--muted)}
  .not-sure b{display:block;color:var(--charcoal-deep);font-family:var(--font-head);font-size:1.1rem;margin-bottom:.3rem}
  .not-sure a.q{display:inline-block;margin-top:.6rem;font-weight:700;color:var(--red-deep);text-decoration:none}
  @media(max-width:900px){.intent-grid{grid-template-columns:1fr 1fr}}
  @media(max-width:560px){.intent-grid{grid-template-columns:1fr}}

  /* featured-projects grid — four across like the intent grid, not 3+1 */
  .proj-cards{grid-template-columns:repeat(4,1fr)}
  @media(max-width:900px){.proj-cards{grid-template-columns:1fr 1fr}}
  @media(max-width:560px){.proj-cards{grid-template-columns:1fr}}

