---
import Layout from '../layouts/Layout.astro';
import { business, buildings, testimonials } from '../data/site';
import { gallery } from '../data/gallery';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import OverlayHero from '../components/OverlayHero.astro';
import PhotoLightbox from '../components/PhotoLightbox.astro';
const b = business;
const find = (slug: string) => buildings.find((x) => x.slug === slug)!;
const self = find('post-frame-garages');
const projects = gallery.filter((g) => g.type === 'post-frame-garages').slice(0, 6);
const review = testimonials.find((t) => t.name === 'Brian Huff')!;

const faqs = [
  { q: "Can a garage be attached to my house?", a: "Yes. We build both attached and standalone post-frame garages, depending on your property and how you want to use the space." },
  { q: "Can it fit an RV or boat?", a: "Yes. Door height and bay depth can be planned around RVs, boats and other tall or long vehicles." },
  { q: "Can the garage match my house?", a: "Yes. Siding, roof color and trim can be styled to match your home rather than look like a separate outbuilding." },
  { q: "Can I insulate and finish the inside?", a: "Yes. Garages can be left as basic shells or insulated and finished depending on how you plan to use them." },
  { q: "Where does Yutzy build garages?", a: "We serve customers across Kansas and Missouri from our Garnett, KS and Fordland, MO locations." },
  { q: "How much does a post-frame garage cost?", a: "Pricing depends on size, number of bays, doors, insulation and finish level. Tell us what you need and we'll help you work through the options and pricing." },
];
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
};
---
<Layout
  title={`${self.seoTitle} | ${b.name}`}
  description="Custom post-frame garages for vehicles, RVs and boats — attached or standalone, styled to match your home. Built by Yutzy Custom Structures across Kansas & Missouri."
  heroOverlay
>
  <OverlayHero
    eyebrow="Custom Post-Frame Garages | Kansas + Missouri"
    title="Room for Everything You Park or Store."
    subtitle="Attached or standalone post-frame garages sized and styled around your vehicles, your property and your home."
    image="images/gallery/g24.webp"
    alt="Red two-car garage with green trim and a covered carport"
    ctaHref="index.html?type=Post-Frame+Garage#contact"
    ctaText="Start Your Garage"
    ctaSecondaryText="See Garage Projects"
    ctaSecondaryHref="#projects"
    areaNote="Building across Kansas and Missouri from Garnett, KS and Fordland, MO."
    full
  />

  <Breadcrumbs items={[{ label: 'What We Build', href: 'index.html#buildings' }, { label: 'Post-Frame Garages' }]} />

  <!-- WHAT DO YOU NEED IT TO HOLD -->
  <section id="why" class="tex">
    <div class="wrap">
      <div class="sec-head">
        <span class="eyebrow">Built Around What You Park</span>
        <h2>What's Going in the Garage?</h2>
        <p>The right garage starts with what you're parking or storing. Tell us what needs to fit and we'll help you plan the bays, doors and layout around it.</p>
      </div>
      <div class="cards">
        <article class="ocard">
          <img class="shot" src="images/gallery/g28.webp" alt="Tan and brown two-car garage with a Yutzy nameplate on the peak" />
          <div class="ocard-body">
            <h3>Vehicles</h3>
            <p>One to four-plus bays for daily drivers, trucks and family vehicles.</p>
          </div>
        </article>
        <article class="ocard">
          <img class="shot" src="images/gallery/g27.webp" alt="Tan and brown four-bay garage with a roof cupola" />
          <div class="ocard-body">
            <h3>RVs + Boats</h3>
            <p>Taller doors and deeper bays sized around larger vehicles and equipment.</p>
          </div>
        </article>
        <article class="ocard">
          <img class="shot" src="images/gallery/g10.webp" alt="Tan post-frame garage with a covered side porch and a single wood post" />
          <div class="ocard-body">
            <h3>Garage + Workshop</h3>
            <p>Split the space between parking and a dedicated work or storage area.</p>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- PLAN YOUR GARAGE -->
  <section class="photo-band">
    <img class="photo-band-bg" src="images/gallery/g29.webp" alt="Gray three-bay garage with a covered entry and landscaped stone accents" />
    <div class="photo-band-scrim"></div>
    <div class="wrap photo-band-inner">
      <span class="eyebrow photo-band-eye">Plan Your Garage</span>
      <h2>Start With What Has to Fit.</h2>
      <p class="photo-band-lead">You don't need exact dimensions before contacting us. How many vehicles, how tall is the tallest one, do you want a workshop bay, should it attach to the house — we'll help you work backward from there to the right size.</p>
      <a class="btn btn-red" href="index.html?type=Post-Frame+Garage#contact">Talk Through My Garage</a>
    </div>
  </section>

  <!-- CONFIGURATIONS -->
  <section>
    <div class="wrap">
      <div class="sec-head">
        <span class="eyebrow">Built Around the Way You Use It</span>
        <h2>One Garage Type. A Lot of Options.</h2>
        <p>These are starting points for inspiration, not fixed packages — every garage is configured around your vehicles and your property.</p>
      </div>
      <ul class="checks checks-grid">
        <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#955a22" stroke-width="2.4"><path d="M20 6L9 17l-5-5"/></svg> <span><b>One to four-plus bays:</b> sized around how many vehicles you need to park.</span></li>
        <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#955a22" stroke-width="2.4"><path d="M20 6L9 17l-5-5"/></svg> <span><b>RV + boat height:</b> taller doors and deeper bays for larger vehicles.</span></li>
        <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#955a22" stroke-width="2.4"><path d="M20 6L9 17l-5-5"/></svg> <span><b>Attached or standalone:</b> connected to your home or built as its own structure.</span></li>
        <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#955a22" stroke-width="2.4"><path d="M20 6L9 17l-5-5"/></svg> <span><b>Insulation + finishing:</b> leave it a shell or finish it out, your call.</span></li>
      </ul>
    </div>
  </section>

  <!-- REAL PROJECTS -->
  <section id="projects" class="alt">
    <div class="wrap">
      <div class="sec-head">
        <span class="eyebrow">Garages By Yutzy</span>
        <h2>See What We've Built.</h2>
        <p>Explore real Yutzy post-frame garages built for vehicles, RVs, boats and workshops across Kansas and Missouri.</p>
      </div>
      <PhotoLightbox images={projects} />
      <p style="text-align:center;margin-top:1.8rem"><a class="btn btn-outline" href="gallery.html">View All Yutzy Projects</a></p>
    </div>
  </section>

  <!-- CONSTRUCTION QUALITY -->
  <section>
    <div class="wrap">
      <div class="sec-head">
        <span class="eyebrow">How We Build</span>
        <h2>Built to Protect What's Inside.</h2>
        <p>A garage has to hold up to daily use and keep what's inside dry and secure. The structure behind the finished garage matters as much as the doors and siding.</p>
      </div>
      <ul class="checks checks-grid">
        <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#955a22" stroke-width="2.4"><path d="M20 6L9 17l-5-5"/></svg> <span><b>Posts + trusses:</b> tighter spacing than a typical post-frame build.</span></li>
        <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#955a22" stroke-width="2.4"><path d="M20 6L9 17l-5-5"/></svg> <span><b>Roofing + siding:</b> durable metal systems with customizable colors.</span></li>
        <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#955a22" stroke-width="2.4"><path d="M20 6L9 17l-5-5"/></svg> <span><b>Foundation:</b> built to your site and how the garage will be used.</span></li>
        <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#955a22" stroke-width="2.4"><path d="M20 6L9 17l-5-5"/></svg> <span><b>Backed in writing:</b> a 5-year workmanship warranty on every build.</span></li>
      </ul>
    </div>
  </section>

  <!-- STYLED TO MATCH -->
  <section class="alt">
    <div class="wrap split-grid">
      <div class="ph split-img"><img class="shot" src="images/gallery/g21.webp" alt="Brown two-car garage with green trim and roof" /></div>
      <div>
        <span class="eyebrow">Styled to Match</span>
        <h2>It Doesn't Have to Look Like a Separate Building.</h2>
        <p class="lead-p">Siding, roof color, trim and entry details can be planned to match your existing home rather than stand out from it — so the finished garage reads as part of the property, not an add-on.</p>
      </div>
    </div>
  </section>

  <!-- CUSTOMIZATION -->
  <section>
    <div class="wrap">
      <div class="sec-head">
        <span class="eyebrow">Make It Work for You</span>
        <h2>Customize It to Fit Your Vehicles and Your Style.</h2>
      </div>
      <ul class="checks checks-grid">
        <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#955a22" stroke-width="2.4"><path d="M20 6L9 17l-5-5"/></svg> Siding + roof colors</li>
        <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#955a22" stroke-width="2.4"><path d="M20 6L9 17l-5-5"/></svg> Overhead door sizes + styles</li>
        <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#955a22" stroke-width="2.4"><path d="M20 6L9 17l-5-5"/></svg> Windows + walk doors</li>
        <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#955a22" stroke-width="2.4"><path d="M20 6L9 17l-5-5"/></svg> Covered entries + porches</li>
        <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#955a22" stroke-width="2.4"><path d="M20 6L9 17l-5-5"/></svg> Insulation + interior finish</li>
        <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#955a22" stroke-width="2.4"><path d="M20 6L9 17l-5-5"/></svg> Attached workshop space</li>
      </ul>
    </div>
  </section>

  <!-- PROCESS -->
  <section class="alt">
    <div class="wrap">
      <div class="sec-head">
        <span class="eyebrow">From Idea to Building</span>
        <h2>You Don't Need Exact Dimensions Yet.</h2>
        <p>Start with what needs to fit inside and how you want it to look. We'll help work through the rest.</p>
      </div>
      <ol class="process">
        <li><span class="pnum">01</span><h3>Tell Us What You Need</h3><p>Vehicles, RVs, boats, workshop space or a combination.</p></li>
        <li><span class="pnum">02</span><h3>Talk Through the Site</h3><p>Attached or standalone, location and how it connects to your home.</p></li>
        <li><span class="pnum">03</span><h3>Size + Configuration</h3><p>Work through bays, doors, height and finish options.</p></li>
        <li><span class="pnum">04</span><h3>Finalize the Build</h3><p>Confirm scope, materials, colors and project details.</p></li>
        <li><span class="pnum">05</span><h3>We Build It</h3><p>The Yutzy team takes the project into construction.</p></li>
      </ol>
    </div>
  </section>

  <!-- TESTIMONIAL -->
  <section>
    <div class="wrap">
      <div class="sec-head">
        <span class="eyebrow">Hear From Someone Who Built With Yutzy</span>
      </div>
      <div class="quotes" style="grid-template-columns:1fr;max-width:680px;margin:0 auto">
        <article class="quote">
          <div class="stars">{"★".repeat(review.stars)}</div>
          <p>&ldquo;{review.quote}&rdquo;</p>
          <p class="who">{review.name} · {review.source}</p>
        </article>
      </div>
    </div>
  </section>

  <!-- SERVICE AREA -->
  <section class="alt" style="text-align:center">
    <div class="wrap">
      <span class="eyebrow">Where We Build</span>
      <h2>Garages Across Kansas + Missouri.</h2>
      <p style="color:var(--muted);max-width:560px;margin:0 auto 1.4rem">Yutzy serves customers from locations in Garnett, Kansas and Fordland, Missouri, with projects across the surrounding region.</p>
      <a class="btn btn-outline" href="index.html#area">See Where We Build</a>
    </div>
  </section>

  <!-- FINANCING -->
  <section style="text-align:center">
    <div class="wrap">
      <span class="eyebrow">Financing</span>
      <h2>Planning a Bigger Project?</h2>
      <p style="color:var(--muted);max-width:560px;margin:0 auto 1.4rem">Financing options may be available for qualifying projects through Rural 1st.</p>
      <a class="btn btn-outline" href="index.html#contact">Explore Financing</a>
    </div>
  </section>

  <!-- FAQ -->
  <section class="alt">
    <div class="wrap faq-wrap">
      <div class="sec-head">
        <span class="eyebrow">Questions</span>
        <h2>Post-Frame Garage Questions</h2>
      </div>
      {faqs.map((f) => (
        <details class="faq-item">
          <summary>{f.q}</summary>
          <p class="faq-a">{f.a}</p>
        </details>
      ))}
    </div>
  </section>

  <!-- RELATED -->
  <section>
    <div class="wrap">
      <div class="sec-head">
        <span class="eyebrow">Related</span>
      </div>
      <div class="cards">
        <article class="card">
          <div class="card-body">
            <h3>Hobby Shops</h3>
            <p>Need dedicated workshop space instead of just parking?</p>
            <a class="q" href="hobby-shops.html">Explore Hobby Shops →</a>
          </div>
        </article>
        <article class="card">
          <div class="card-body">
            <h3>Pole Barns</h3>
            <p>Looking for equipment or ag storage instead?</p>
            <a class="q" href="pole-barns.html">Explore Pole Barns →</a>
          </div>
        </article>
        <article class="card">
          <div class="card-body">
            <h3>Financing</h3>
            <p>Explore financing options that may be available for qualifying projects.</p>
            <a class="q" href="index.html#contact">Explore Financing →</a>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- FINAL CTA -->
  <section class="final-cta">
    <img class="final-cta-bg" src="images/gallery/g30.webp" alt="" />
    <div class="final-cta-scrim"></div>
    <div class="wrap final-cta-inner">
      <h2>Tell Us What Needs to Fit Inside.</h2>
      <p>Share what you're parking or storing and where the garage will go. We'll help you work through size, layout and next steps.</p>
      <div class="hero-cta">
        <a class="btn btn-red" href="index.html?type=Post-Frame+Garage#contact">Start My Garage</a>
        <a class="btn btn-ghost" href={`tel:${b.phoneMainHref}`}>Call Yutzy</a>
      </div>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</Layout>

<style>
  .final-cta{position:relative;overflow:hidden;text-align:center;padding:clamp(4rem,10vw,6rem) 0}
  .final-cta-bg{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:0}
  .final-cta-scrim{position:absolute;inset:0;background:linear-gradient(rgba(30,35,33,.86),rgba(30,35,33,.9));z-index:1}
  .final-cta-inner{position:relative;z-index:2;color:#fff}
  .final-cta h2{font-size:clamp(1.9rem,4.5vw,2.7rem);margin:0 0 .8rem;max-width:20ch;margin-left:auto;margin-right:auto;color:#fff}
  .final-cta p{color:rgba(255,255,255,.86);max-width:56ch;margin:0 auto 1.8rem}
  .final-cta .hero-cta{justify-content:center}
</style>
