---
import Layout from '../layouts/Layout.astro';
import { business, buildings, testimonials } from '../data/site';
import { gallery } from '../data/gallery';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import OverlayHero from '../components/OverlayHero.astro';
import PhotoLightbox from '../components/PhotoLightbox.astro';
const b = business;
const find = (slug: string) => buildings.find((x) => x.slug === slug)!;
const self = find('slab-homes');
const barndo = find('barndominiums');
const postFrame = find('post-frame-homes');
const projects = gallery.filter((g) => g.type === 'slab-homes').slice(0, 6);
const review = testimonials.find((t) => t.name === 'Michelle Honn')!;

const faqs = [
  { q: "Do I need a completed floor plan before contacting Yutzy?", a: "No. Start with how you want to live and we'll help you work through the layout from there." },
  { q: "Can I customize the floor plan?", a: "Yes. Layouts can be planned around the rooms, storage and flow that matter most to you." },
  { q: "Can my slab home include an attached garage?", a: "Yes. Attached garages and shops are a common part of these builds." },
  { q: "Where does Yutzy build homes?", a: "We serve customers across Kansas and Missouri from our Garnett, Kansas and Fordland, Missouri locations." },
  { q: "Do you offer financing?", a: "Financing options may be available for qualifying projects through Rural 1st." },
  { q: "How much does a custom slab home cost?", a: "Every home is different. Size, floor plan, finishes, site conditions, garage space and other selections all affect the project cost. Start by telling us what you're considering and we'll help you understand the next steps." },
];
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
};
---
<Layout
  title={`${self.seoTitle} | ${b.name}`}
  description="Custom slab homes with flexible floor plans and no wasted square footage — built by Yutzy Custom Structures across Kansas & Missouri."
>
  <Breadcrumbs items={[{ label: 'What We Build', href: 'index.html#buildings' }, { label: 'Slab Homes' }]} />

  <OverlayHero
    eyebrow="Custom Slab Homes | Kansas + Missouri"
    title="Single-Level Living. Built Around You."
    subtitle="Custom slab homes designed around how you want to live, with flexible floor plans, comfortable everyday spaces and no wasted square footage."
    image="images/gallery/g33.webp"
    alt="Gray slab home with a full-length covered porch and stone-clad columns"
    ctaHref="index.html?type=Slab+Home#contact"
    ctaText="Start Your Home"
    ctaSecondaryText="See Home Projects"
    ctaSecondaryHref="#projects"
    areaNote="Building Since 2005 · Kansas + Missouri · Custom Floor Plans"
  />

  <!-- WHY A SLAB HOME -->
  <section id="why">
    <div class="wrap">
      <div class="sec-head">
        <span class="eyebrow">Why a Slab Home?</span>
        <h2>Simple by Design. Completely Custom to You.</h2>
        <p>A slab home gives you the comfort and flexibility of a custom home with everything on one level — no basement, no stairs, just a floor plan designed around the way you want it to function.</p>
      </div>
      <div class="cards">
        <article class="ocard">
          <img class="shot" src="images/gallery/g41.webp" alt="White slab home with a covered back porch overlooking a pond" />
          <div class="ocard-body">
            <h3>Easy Everyday Living</h3>
            <p>Keep the spaces you use most on one level with an easy flow from room to room.</p>
          </div>
        </article>
        <article class="ocard">
          <img class="shot" src="images/gallery/g43.webp" alt="Tan slab home, rear elevation with matching windows" />
          <div class="ocard-body">
            <h3>Use Every Square Foot</h3>
            <p>Design the home around the rooms and storage you actually need instead of paying for space you won't use.</p>
          </div>
        </article>
        <article class="ocard">
          <img class="shot" src="images/gallery/g42.webp" alt="Brown ranch-style home with a full-length wraparound covered porch" />
          <div class="ocard-body">
            <h3>Built for the Long Term</h3>
            <p>Single-level living can make the home easier to enjoy through every stage of life.</p>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- HELP PICTURE IT -->
  <section class="photo-band">
    <img class="photo-band-bg" src="images/gallery/g07.webp" alt="White slab home with a wraparound covered porch, rocking chairs and an attached shop wing" />
    <div class="photo-band-scrim"></div>
    <div class="wrap photo-band-inner">
      <span class="eyebrow photo-band-eye">Picture It</span>
      <h2>What Would Make This Home Work Better for You?</h2>
      <p class="photo-band-lead">Open kitchen and living area, a large pantry, a mudroom, an attached garage, a covered porch, an oversized primary suite, a home office, extra storage, room for kids, guests or aging parents. Start with how you want to live — the floor plan can come next.</p>
      <a class="btn btn-red" href="index.html?type=Slab+Home#contact">Talk Through Your Home</a>
    </div>
  </section>

  <!-- REAL PROJECTS -->
  <section id="projects" class="alt">
    <div class="wrap">
      <div class="sec-head">
        <span class="eyebrow">Homes By Yutzy</span>
        <h2>See What We've Built.</h2>
        <p>Explore real Yutzy homes for ideas on floor plans, exterior styles, garages, porches and everyday living spaces.</p>
      </div>
      <PhotoLightbox images={projects} />
      <p style="text-align:center;margin-top:1.8rem"><a class="btn btn-outline" href="gallery.html">View All Yutzy Projects</a></p>
    </div>
  </section>

  <!-- FLOOR PLANS -->
  <section>
    <div class="wrap">
      <div class="sec-head">
        <span class="eyebrow">Custom Floor Plans</span>
        <h2>The Floor Plan Should Fit Your Life. Not the Other Way Around.</h2>
        <p>Your home can be planned around the spaces that matter most to you, whether that's a big kitchen, oversized garage, extra storage, home office or room for the family to gather.</p>
      </div>
      <ul class="checks checks-grid">
        <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#955a22" stroke-width="2.4"><path d="M20 6L9 17l-5-5"/></svg> Open-concept living</li>
        <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#955a22" stroke-width="2.4"><path d="M20 6L9 17l-5-5"/></svg> Primary suites</li>
        <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#955a22" stroke-width="2.4"><path d="M20 6L9 17l-5-5"/></svg> Kitchens + pantries</li>
        <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#955a22" stroke-width="2.4"><path d="M20 6L9 17l-5-5"/></svg> Garages + storage</li>
        <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#955a22" stroke-width="2.4"><path d="M20 6L9 17l-5-5"/></svg> Mudrooms</li>
        <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#955a22" stroke-width="2.4"><path d="M20 6L9 17l-5-5"/></svg> Porches + outdoor space</li>
      </ul>
    </div>
  </section>

  <!-- EXTERIOR -->
  <section class="alt">
    <div class="wrap split-grid split-reverse">
      <div>
        <span class="eyebrow">Exterior Design</span>
        <h2>Make It Feel Like Home Before You Ever Walk Inside.</h2>
        <p class="lead-p">Rooflines, siding, metal accents, stone, windows, porches and color choices can completely change the character of your home.</p>
      </div>
      <div class="ph split-img"><img class="shot" src="images/gallery/g34.webp" alt="Close-up of an arched wood front door with sidelights on a slab home" /></div>
    </div>
  </section>

  <!-- HOW YUTZY BUILDS -->
  <section>
    <div class="wrap">
      <div class="sec-head">
        <span class="eyebrow">Behind the Finishes</span>
        <h2>Built for Everyday Living.</h2>
        <p>What you see matters. What sits underneath it matters just as much — the foundation, framing, insulation and exterior systems all play a role in how your home performs over time.</p>
      </div>
      <ul class="checks checks-grid">
        <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#955a22" stroke-width="2.4"><path d="M20 6L9 17l-5-5"/></svg> <span><b>Foundation:</b> a slab system suited to your site and design.</span></li>
        <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#955a22" stroke-width="2.4"><path d="M20 6L9 17l-5-5"/></svg> <span><b>Structure:</b> stud-frame construction built to your plan.</span></li>
        <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#955a22" stroke-width="2.4"><path d="M20 6L9 17l-5-5"/></svg> <span><b>Insulation:</b> well-insulated construction throughout.</span></li>
        <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#955a22" stroke-width="2.4"><path d="M20 6L9 17l-5-5"/></svg> <span><b>Roof + exterior:</b> durable materials with customizable finishes.</span></li>
      </ul>
    </div>
  </section>

  <!-- COMPARE HOME TYPES -->
  <section class="alt">
    <div class="wrap">
      <div class="sec-head">
        <span class="eyebrow">Still Deciding</span>
        <h2>Not Sure Which Type of Home Fits You Best?</h2>
      </div>
      <div class="cards">
        <article class="ocard">
          <div class="ocard-body">
            <h3>Slab Home</h3>
            <p>A strong fit for customers who want a traditional custom-home layout with everything on one level.</p>
            <span class="q">You're Here</span>
          </div>
        </article>
        <article class="ocard">
          <img class="shot" src={barndo.img} alt={barndo.alt} />
          <div class="ocard-body">
            <h3>{barndo.name}</h3>
            <p>A great option if you want residential living combined with a larger attached garage, shop or flexible-use space.</p>
            <a class="q" href="barndominiums.html">Explore Barndominiums →</a>
          </div>
        </article>
        <article class="ocard">
          <img class="shot" src={postFrame.img} alt={postFrame.alt} />
          <div class="ocard-body">
            <h3>{postFrame.name}</h3>
            <p>A flexible residential option for customers interested in post-frame construction with a custom-home feel.</p>
            <a class="q" href="post-frame-homes.html">Explore Post-Frame Homes →</a>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- PROCESS -->
  <section>
    <div class="wrap">
      <div class="sec-head">
        <span class="eyebrow">Building Your Home</span>
        <h2>Start With the Idea. We'll Help With the Next Steps.</h2>
      </div>
      <ol class="process">
        <li><span class="pnum">01</span><h3>Tell Us About Your Property</h3><p>Where you're building and what you're envisioning.</p></li>
        <li><span class="pnum">02</span><h3>Talk Through How You Want to Live</h3><p>Rooms, layout, garage, storage and priorities.</p></li>
        <li><span class="pnum">03</span><h3>Design + Planning</h3><p>Work through the home layout, selections and project scope.</p></li>
        <li><span class="pnum">04</span><h3>Finalize the Details</h3><p>Confirm plans and construction decisions.</p></li>
        <li><span class="pnum">05</span><h3>Build Your Home</h3><p>Yutzy takes the project into construction.</p></li>
      </ol>
    </div>
  </section>

  <!-- TESTIMONIAL -->
  <section class="alt">
    <div class="wrap">
      <div class="sec-head">
        <span class="eyebrow">Hear From a Yutzy Homeowner</span>
      </div>
      <div class="quotes" style="grid-template-columns:1fr;max-width:680px;margin:0 auto">
        <article class="quote">
          <div class="stars">{"★".repeat(review.stars)}</div>
          <p>&ldquo;{review.quote}&rdquo;</p>
          <p class="who">{review.name} · {review.source}</p>
        </article>
      </div>
    </div>
  </section>

  <!-- FINANCING -->
  <section>
    <div class="wrap" style="text-align:center">
      <span class="eyebrow">Financing</span>
      <h2>Planning the Home? Let's Talk About the Investment Too.</h2>
      <p style="color:var(--muted);max-width:560px;margin:0 auto 1.4rem">Financing options may be available for qualifying projects through Rural 1st.</p>
      <a class="btn btn-outline" href="index.html#contact">Explore Financing</a>
    </div>
  </section>

  <!-- FAQ -->
  <section class="alt">
    <div class="wrap faq-wrap">
      <div class="sec-head">
        <span class="eyebrow">Questions</span>
        <h2>Slab Home Questions</h2>
      </div>
      {faqs.map((f) => (
        <details class="faq-item">
          <summary>{f.q}</summary>
          <p class="faq-a">{f.a}</p>
        </details>
      ))}
    </div>
  </section>

  <!-- FINAL CTA -->
  <section class="final-cta">
    <img class="final-cta-bg" src="images/gallery/g07.webp" alt="" />
    <div class="final-cta-scrim"></div>
    <div class="wrap final-cta-inner">
      <h2>You Don't Need Every Decision Made Yet.</h2>
      <p>Tell us where you're building and what you're imagining for the home. We'll help you work through the details from there.</p>
      <div class="hero-cta">
        <a class="btn btn-red" href="index.html?type=Slab+Home#contact">Start My Home</a>
        <a class="btn btn-ghost" href={`tel:${b.phoneMainHref}`}>Call Yutzy</a>
      </div>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</Layout>

<style>
  .final-cta{position:relative;overflow:hidden;text-align:center;padding:clamp(4rem,10vw,6rem) 0}
  .final-cta-bg{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:0}
  .final-cta-scrim{position:absolute;inset:0;background:linear-gradient(rgba(30,35,33,.86),rgba(30,35,33,.9));z-index:1}
  .final-cta-inner{position:relative;z-index:2;color:#fff}
  .final-cta h2{font-size:clamp(1.9rem,4.5vw,2.7rem);margin:0 0 .8rem;max-width:20ch;margin-left:auto;margin-right:auto;color:#fff}
  .final-cta p{color:rgba(255,255,255,.86);max-width:56ch;margin:0 auto 1.8rem}
  .final-cta .hero-cta{justify-content:center}
</style>
